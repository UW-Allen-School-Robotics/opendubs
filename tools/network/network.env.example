# /etc/opendubs/network.env on the Thor: root:root, mode 0600. NEVER commit the real file.
# The read-only router account for opendubs-netmon and netdiag (notes/design/network-router-api.md §2).
# The password is typed in by whoever creates the account on the router; it never goes in chat.
ROUTER_URL=https://10.42.2.1
ROUTER_USER=netmon
ROUTER_PASS=
# SHA-256 of the router's self-signed certificate, from:
#   openssl s_client -connect 10.42.2.1:443 </dev/null 2>/dev/null | openssl x509 -outform DER | sha256sum
ROUTER_CERT_SHA256=
