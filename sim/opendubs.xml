<mujoco model="opendubs">
  <!-- OpenDubs: chassis, wheels, and the Z-axis, in the CAD model's own frame.

       THE CAD ORIGIN IS THE DATUM. Meshes are exported at it, and every offset below is the
       real spatial relationship rather than a convenience frame invented for the simulator.
       The floor is at z = -94 mm: the wheels are 140 mm across with centres at z = -24, so
       their contact patch lands there. That is derived from the meshes, not assumed.

       The arms are NOT modelled here. openarm_assets ships a complete bimanual model including
       the stock V1 extrusion frame they stand on; it gets attached to the lift platform below.
       Its own root frame has the origin at the BOTTOM of the extrusion, centred in Y, spanning
       x -155..+95 — so the origin sits 30 mm ahead of that body's geometric centre.

       Units: the meshes are millimetres, MJCF is metres, hence scale 0.001 throughout. -->

  <compiler angle="radian" meshdir="meshes/"/>
  <!-- implicitfast, not the default explicit Euler. Wheel and roller inertias are small
       against the damping and the velocity actuators driving them: a 0.77 kg wheel at kv 1 has
       a time constant well under the timestep, which explicit integration turns into a
       divergence. Driving in reverse used to spin the rear rollers to 16000 rad/s and trip
       MuJoCo's own reset. Implicit integration of those damping terms costs almost nothing. -->
  <option gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <!-- Big enough to render a readable preview offscreen; MuJoCo's default is 640x480. -->
    <global offwidth="1640" offheight="1120"/>
  </visual>

  <default>
    <default class="visual">
      <geom group="2" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="3"/>
    </default>
    <default class="roller">
      <!-- Rollers collide with the GROUND AND NOTHING ELSE. contype 2 / conaffinity 0 against
           a ground plane whose conaffinity includes bit 2: roller-vs-ground matches, and
           roller-vs-roller, roller-vs-chassis and roller-vs-arm all fail both tests. Without
           this the rollers of one wheel fight each other (they overlap, as real ones do) and
           every wheel sits inside the chassis bounding box, which is a crude box that
           swallows them. -->
      <geom type="capsule" size="0.010" contype="2" conaffinity="0" group="3"
            rgba="0.10 0.10 0.11 1"/>
    </default>
  </default>

  <asset>
    <mesh name="chassis"  file="chassis.stl"     scale="0.001 0.001 0.001"/>
    <mesh name="wheel_fl" file="FL-wheel.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="wheel_fr" file="FR-wheel.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="wheel_rl" file="RL-wheel.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="wheel_rr" file="RR-wheel.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="zaxis"    file="z-axis-down.stl" scale="0.001 0.001 0.001"/>
    <mesh name="channel"  file="1120_channel.stl" scale="0.001 0.001 0.001"/>
    <!-- The pan/tilt head, exported IN CAD COORDINATES: these meshes carry their own absolute
         position, so they are placed by cancelling the head frame's offset rather than by
         positioning each part. See the head body below. -->
    <mesh name="pt_body"   file="pt_tilt_body.stl"   scale="0.001 0.001 0.001"/>
    <mesh name="pt_screen" file="pt_screen_cover.stl" scale="0.001 0.001 0.001"/>
    <mesh name="d415"      file="D415.stl"            scale="0.001 0.001 0.001"/>
    <material name="frame" rgba="0.25 0.26 0.28 1"/>
    <material name="rubber" rgba="0.12 0.12 0.13 1"/>
    <material name="plate" rgba="0.55 0.57 0.60 1"/>
  </asset>

  <worldbody>
    <light pos="1 -1 2.5" dir="-0.3 0.3 -1" diffuse="0.9 0.9 0.9"/>
    <!-- The floor, placed from the wheels rather than assumed: -94 mm in CAD coordinates. -->
    <geom name="ground" type="plane" pos="0 0 -0.094" size="4 4 0.05" rgba="0.18 0.19 0.2 1"
          conaffinity="3"/>

    <body name="chassis" pos="0 0 0">
      <!-- The base is FREE: it stands on its wheels and goes where they push it. It used to be
           welded to the world, back when the wheels were scenery. -->
      <freejoint name="base"/>
      <!-- ESTIMATED, not weighed — and the model will not run without it. Taking mass from the
           chassis mesh would give 169 kg, because that mesh is a bounding box and MuJoCo fills
           it with water at its default density. 40 kg with the centre of mass low (batteries
           and motors sit near the floor, not at the box's centroid) is a guess that behaves
           sanely. Weigh the robot before believing anything dynamic. -->
      <inertial pos="0.29 0 0.02" mass="40" diaginertia="1.9 1.9 2.8"/>
      <geom class="visual"    type="mesh" mesh="chassis" material="frame"/>
      <geom class="collision" type="mesh" mesh="chassis" name="chassis_collision"/>


      <!-- THE WHEELS. Mecanum, so they are not cylinders with sideways grip: each is a hub that
           turns on its axle carrying a ring of free-spinning rollers skewed 45 degrees. That
           skew is the whole mechanism — a driven hub pushes along its rollers' perpendicular,
           and the four diagonal push directions add up to travel in any direction.

           MODELLED, NOT SUPPLIED. The four wheel meshes are byte-identical 412-triangle
           cylinders with no roller detail and no handedness, so the rollers here are authored:
           16 capsules of radius 10 mm on a 60 mm hub, giving the measured 140 mm diameter and
           50 mm width. The count and the capsule shape are a simplification (real rollers are
           barrels that taper at the ends), which is what this model wants for collision
           geometry. What is NOT invented is the handedness: FL and RR skew one way, FR and RL
           the other, taken from the firmware mixer in rc_serial_probe, where FL and RR share a
           strafe sign and FR and RL share the opposite one.

           Handedness was then CHECKED, not assumed — see scene.py --drive, which runs the
           firmware's own mixer and reports where the robot actually goes. -->
      <body name="wheel_fl" pos="0.528 0.2945 -0.024">
        <joint name="wheel_fl" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom class="visual" type="mesh" mesh="wheel_fl" material="rubber"
              pos="-0.528 -0.2945 0.024"/>
        <replicate count="16" euler="0 22.5 0">
          <body pos="0.060 0 0">
            <joint type="hinge" axis="0 0.70711 -0.70711" damping="0.00002" armature="5e-05"/>
            <geom class="roller" fromto="0 -0.01499 0.01499 0 0.01499 -0.01499"/>
          </body>
        </replicate>
      </body>

      <body name="wheel_fr" pos="0.528 -0.2945 -0.024">
        <joint name="wheel_fr" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom class="visual" type="mesh" mesh="wheel_fr" material="rubber"
              pos="-0.528 0.2945 0.024"/>
        <replicate count="16" euler="0 22.5 0">
          <body pos="0.060 0 0">
            <joint type="hinge" axis="0 0.70711 0.70711" damping="0.00002" armature="5e-05"/>
            <geom class="roller" fromto="0 -0.01499 -0.01499 0 0.01499 0.01499"/>
          </body>
        </replicate>
      </body>

      <body name="wheel_rl" pos="0.12 0.2945 -0.024">
        <joint name="wheel_rl" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom class="visual" type="mesh" mesh="wheel_rl" material="rubber"
              pos="-0.12 -0.2945 0.024"/>
        <replicate count="16" euler="0 22.5 0">
          <body pos="0.060 0 0">
            <joint type="hinge" axis="0 0.70711 0.70711" damping="0.00002" armature="5e-05"/>
            <geom class="roller" fromto="0 -0.01499 -0.01499 0 0.01499 0.01499"/>
          </body>
        </replicate>
      </body>

      <body name="wheel_rr" pos="0.12 -0.2945 -0.024">
        <joint name="wheel_rr" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom class="visual" type="mesh" mesh="wheel_rr" material="rubber"
              pos="-0.12 0.2945 0.024"/>
        <replicate count="16" euler="0 22.5 0">
          <body pos="0.060 0 0">
            <joint type="hinge" axis="0 0.70711 -0.70711" damping="0.00002" armature="5e-05"/>
            <geom class="roller" fromto="0 -0.01499 0.01499 0 0.01499 -0.01499"/>
          </body>
        </replicate>
      </body>

      <!-- The Z-axis. A scissor lift in reality; a prismatic joint here, because choreography
           only cares where the platform ends up. Stroke 275.1 mm = 10.83 in (manufacturer).
           Zero is the lowered state the mesh was exported in. -->
      <body name="lift_platform" pos="0 0 0">
        <!-- STIFF. A scissor lift driven through a screw does not bounce, and the model had it
             springing at about 2 Hz: kp 4000 against the ~25 kg it carries is a soft spring,
             and damping 20 against a critical 630 is a damping ratio of 0.03. Raised to a
             stiffness that is rigid at the scale anything here cares about, and damped at the
             joint as well so the lift settles dead rather than ringing. The real mechanism is
             also not backdrivable, which this approximates by simply being hard to move. -->
        <joint name="zaxis" type="slide" axis="0 0 1" range="0 0.2751" damping="3000"/>
        <geom class="visual"    type="mesh" mesh="zaxis" material="plate"/>
        <geom class="collision" type="mesh" mesh="zaxis" name="lift_collision"/>
        <inertial pos="0.348 0 0.3571" mass="8" diaginertia="0.2 0.2 0.3"/>

        <!-- Where the arms stand: openarm_body_link0's ORIGIN, in CAD coordinates.
             x 0.423 as measured in CAD. (An earlier guess of 0.453 came from reading "423 to
             the centre of the root body" against that body's mesh, which is offset 30 mm from
             its own origin; it put the frame's front face exactly flush with the plate edge,
             which looked like confirmation and was coincidence. Checked on the render: 30 mm
             too far forward.)
             z 0.3575 is the plate's top face in the lowered state.
             ATTACH POINT — the bimanual model goes here:
               <include file="openarm_bimanual_decorated.xml"/> with its root at this site. -->
        <site name="arm_frame_mount" pos="0.423 0 0.3575" size="0.012" rgba="0.9 0.5 0.1 1"/>

        <!-- THE HEAD. Rides with the extrusion, so it hangs off the lift platform.
             TILT AXIS at CAD (423, 0, 1245.575), measured — 115.1 mm above the top of the arm
             extrusion, on the same x as the arm frame. The PAN axis is the vertical through it.

             THE MESHES ARE EXPORTED IN CAD COORDINATES, so the parts are not positioned one by
             one. Each geom carries a single transform that cancels this body's offset, and
             every vertex lands where CAD put it.

             That transform is a 180 degree yaw (quat 0 0 0 1) plus pos (0.423, 0.00185,
             -1.245575), because the export is turned around and 1.85 mm off the centreline:
               * the yaw, because as exported the screen sits at x 363..386 and the camera at
                 x 364..384, both BEHIND the tilt axis at 423 — the export is posed at pan=180.
                 Confirmed: the head faces forward, the way the front wheels do (FL/FR x=528,
                 RL/RR x=120, so +x is forward).
               * the 1.85 mm, because the exported parts are centred on y = +1.85 rather than
                 0. The yaw puts that at -1.85 and the offset brings it back to the centreline.
             After both, the screen spans x 460.0..482.8 and the camera x 461.6..481.6, ahead of
             the axis and facing +x, with y symmetric about 0. -->
        <body name="head_pan" pos="0.423 0 1.245575">
          <!-- PAN is limited by nothing but the servo's own travel: the goBILDA 2000-series
               dual-mode servo turns 300 deg, and the horn was set at the middle of that, so
               +/-150 deg. No mechanical stop in the bracket and no slip ring on this build.
               That is deliberately wide — whether the head can actually sweep that far without
               meeting the arms or the extrusion is a question for the model to answer, not one
               to pre-empt by narrowing the joint. -->
          <joint name="head_pan" type="hinge" axis="0 0 1" damping="1"
                 range="-2.6180 2.6180"/>
          <!-- The pan bearing and its bracket are not separate meshes; this body needs mass
               because MuJoCo refuses a moving body without it. Nominal, not measured. -->
          <inertial pos="0 0 0" mass="0.3" diaginertia="0.001 0.001 0.001"/>
          <body name="head_tilt">
            <!-- TILT TRAVEL IS ASYMMETRIC, and measured. From firmware/tab5_pantilt/README.md,
                 characterised by creeping the servo and watching current, soft-stopping at
                 0.20 A so it never stalled:
                   920 us  full up      1545 us  HORIZONTAL      1650 us  full down
                   hard stop measured at 1680 us
                 The goBILDA 2000-series dual-mode servo travels 300 deg out of the box (their
                 spec), so 500-2500 us is 6.667 us/deg, giving 93.8 deg UP and 15.8 deg
                 DOWN, with the hard stop a further 4.5 deg below.

                 NOTE that README does its own arithmetic at 7.14 us/deg, from an assumed 280
                 deg of travel. Its own observation contradicts that: it records 920 us as
                 "slightly past vertical", which 7.14 makes 87.5 deg — slightly SHORT of
                 vertical. At 6.667 it is 93.8, past vertical, as observed. The servo
                 spec and the eye agree; the assumed 280 was the odd one out.
                 STILL DERIVED, not measured: nobody has put a protractor on this axis. One
                 reading at 920 us would settle it.

                 Positive here is DOWN: the joint turns about +y, so +x swings toward -z.
                 Confirmed on the model — +30 deg drops the camera face from z 1313.6 to
                 1275.2. -->
            <joint name="head_tilt" type="hinge" axis="0 1 0" damping="1"
                   range="-1.6362 0.2749"/>
            <geom class="visual" type="mesh" mesh="pt_body"   material="frame"
                  quat="0 0 0 1" pos="0.423 0.00185 -1.245575"/>
            <geom class="visual" type="mesh" mesh="pt_screen" material="plate"
                  quat="0 0 0 1" pos="0.423 0.00185 -1.245575"/>
            <geom class="visual" type="mesh" mesh="d415"      material="rubber"
                  quat="0 0 0 1" pos="0.423 0.00185 -1.245575"/>

            <!-- What the arms must not hit: one coarse box over the whole head — body, screen
                 and the camera on top. From the placed mesh extents, relative to the tilt axis:
                 x -29.6..59.8, y -79.0..79.0, z -55.8..79.5 mm, rounded outward. The arms need
                 to know the head is there, not its fillets, and large is the safe error. -->
            <geom class="collision" type="box" pos="0.015 0 0.012" size="0.045 0.079 0.068"
                  name="head_collision"/>

            <!-- Centre of the D415's front face. NOT the optical frame: RealSense puts the
                 depth origin at the left imager, which we have not located. -->
            <site name="d415_face" pos="0.0586 0.0005 0.0680" size="0.006" rgba="0.95 0.65 0.15 1"/>
          </body>
        </body>
        <!-- The 1120 extrusion is NOT placed. Its mesh is still in its own part frame (48 x 48
             section, 120 mm long, running along y) and its pose is unknown, so it is left out
             rather than put somewhere plausible-looking: a structural member in the wrong place
             silently corrupts clearance, which is worse than a missing one. -->
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Position control, matching how the real thing is commanded: a target height, with the
         firmware's guard and relays doing the work of getting there. -->
    <position name="zaxis_pos" joint="zaxis" kp="200000" dampratio="1" ctrlrange="0 0.2751"/>

    <!-- The wheels. Velocity control, which is what the ESCs take: the firmware sends a
         throttle per wheel, not a torque. ctrlrange is +/-30 rad/s -- 2.1 m/s at a 70 mm
         radius, comfortably past anything this robot does -- so a slider cannot ask for a
         speed and quietly get a clipped one.
         ORDER IS FL, FR, RL, RR, matching driveMix() in firmware/rc_serial_probe. -->
    <velocity name="wheel_fl" joint="wheel_fl" kv="1" ctrlrange="-30 30"/>
    <velocity name="wheel_fr" joint="wheel_fr" kv="1" ctrlrange="-30 30"/>
    <velocity name="wheel_rl" joint="wheel_rl" kv="1" ctrlrange="-30 30"/>
    <velocity name="wheel_rr" joint="wheel_rr" kv="1" ctrlrange="-30 30"/>

    <!-- The head. Without these the two head joints are the only unactuated ones in the whole
         model — the arms bring their own 18 with them — so the viewer's Control panel had
         sliders for everything except the thing we most want to aim.

         ctrlrange matches each joint's range exactly, so a slider cannot command past a limit
         the servo does not have. kp is sized against the real load rather than guessed: the
         tilt body's centre of mass sits 23.6 mm from its axis, so gravity pulls with up to
         0.69 Nm, and holding that within a degree needs kp >= 40. 60 gives margin. Pan carries
         no gravity load at all — its axis is vertical — so it only needs enough to feel crisp.

         Units are RADIANS, which is what the sliders show: tilt runs -1.636 (93.8 deg up) to
         +0.275 (15.8 deg down), pan +/-2.618 (150 deg). -->
    <position name="head_pan_pos"  joint="head_pan"  kp="30" dampratio="1"
              ctrlrange="-2.6180 2.6180"/>
    <position name="head_tilt_pos" joint="head_tilt" kp="60" dampratio="1"
              ctrlrange="-1.6362 0.2749"/>
  </actuator>
</mujoco>
