# --- Secrets / per-unit identity (never commit) ---
.env
.env.local
.env.*.local
# per-deployment private config (network, hostnames, keys) — never public
ops/

# working design notes not yet vetted for the repo (validate before promoting)
notes/drafts/

# --- Dev-machine / agent config ---
.claude/
.mcp.json
.figma_plan.md
.DS_Store

# --- Python ---
.venv/
__pycache__/
*.pyc
*.egg-info/
*.pt

# --- PlatformIO / firmware build artifacts (matches firmware/*/.pio too) ---
.pio/
.pio_env/

# --- Node / frontend tooling ---
node_modules/

# --- MkDocs build output ---
site/

# --- Vendored M5Stack reference libs: pulled at build time via pinned lib_deps,
#     kept locally only for offline reading. Not part of the published source. ---
/M5StamPLC/
/M5Unit-8Servo/
/M5Unit-Encoder/
/M5Unit-HUB/

# --- ESP-IDF (dual-framework Tab5 builds): component-manager downloads and the
# generated per-env sdkconfig are all reproducible from platformio.ini +
# sdkconfig.defaults, which ARE tracked. ---
managed_components/
dependencies.lock
sdkconfig
sdkconfig.*
!sdkconfig.defaults
# ...and sdkconfig.vendor, the Tab5 demo's own committed config, which we build ON TOP of.
!sdkconfig.vendor

# MuJoCo scribbles a load log next to whatever it compiles
MUJOCO_LOG.TXT

# --- Keys and certificates. Public SSH keys (*.pub) are fine; private material never is. ---
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
!*.pub

# --- Firmware images and app packages: built from source, or pulled off a device. A provisioning
#     image can carry Wi-Fi credentials. ---
*.bin
*.elf
*.hex
*.uf2
*.apk
*.aab

# --- Recordings, logs, dumps and bags pulled off the robot. Keep them outside the repo; a log that
#     is evidence for a write-up is added deliberately (see the exception below). ---
*.log
!notes/history/**/*.log
*.mcap
*.db3
*.bag
*.pcap
*.mp4
*.mov
*.mkv
*.webm
*.HEIC
*.heic
core
core.[0-9]*

# --- Caches and editor / OS junk ---
.history/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.gradle/
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
desktop.ini
