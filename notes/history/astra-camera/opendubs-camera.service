[Unit]
Description=OpenDubs camera driver (Orbbec Astra -> /camera/* ROS 2 topics)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
ExecStart=/opt/opendubs/ros/camera.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
