[Unit]
Description=OpenDubs Foxglove bridge (ROS graph → Foxglove app, ws :8765)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
ExecStart=/opt/opendubs/ros/foxglove.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
