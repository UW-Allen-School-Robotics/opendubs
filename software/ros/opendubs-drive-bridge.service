[Unit]
# /cmd_vel → the StamPLC's `DRIVE` command, and its `[ODO]` line → /odom + TF odom→base_link.
# Speaks UDP 5005 directly; the dashboard is deliberately not in the motion path.
#
# Safe to leave enabled. It is inert unless BOTH something publishes /cmd_vel and CH5 is in AUTO —
# the StamPLC ignores host drive commands otherwise, and its arm gate additionally requires the
# contactor closed, no e-stop, a live in-band RC link and a stable control loop. Authority is the
# physical switch, by design (docs/control-authority.md).
Description=OpenDubs drive bridge (/cmd_vel -> DRIVE, [ODO] -> /odom + TF)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=emmar
Environment=HOME=/home/emmar
# Top speed is UNMEASURED (punch list C2). Set these once it is known — getting them wrong does
# not make the robot unsafe, it makes a planner's velocity model wrong.
Environment=OPENDUBS_MAX_LIN=0.5
Environment=OPENDUBS_MAX_ANG=1.0
ExecStart=/opt/opendubs/ros/drive-bridge.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
