[Unit]
# The base owner's commands (forwarded by base_selector on /opendubs/drive/cmd_vel) → the StamPLC's
# `DRIVE` command, and its `[ODO]` line → /odom + TF odom→base_link.
# Speaks UDP 5005 directly; the dashboard is deliberately not in the motion path.
#
# Safe to leave enabled. It is inert unless BOTH a program holds the base (/base/claim) and CH5 is in AUTO —
# the StamPLC ignores host drive commands otherwise, and its arm gate additionally requires the
# contactor closed, no e-stop, a live in-band RC link and a stable control loop. Authority is the
# physical switch, by design (docs/control-authority.md).
Description=OpenDubs drive bridge (base owner's commands -> DRIVE, [ODO] -> /odom + TF)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
# The robot's DDS settings (ros-dds.env, installed by provision-ros.sh): UDP over loopback only, so
# no shared memory (a long-lived subscriber on it can go deaf, workplan L.10) and no multicast.
EnvironmentFile=/etc/opendubs/ros-dds.env
# The software speed cap and the speeds at it, per robot, SHARED with opendubs-dance-tracker so the two
# cannot disagree (drive_scale.py). Optional: without it, drive-bridge.sh's defaults apply.
EnvironmentFile=-/etc/opendubs/base.env
ExecStart=/opt/opendubs/ros/drive-bridge.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
