# The robot's ROS 2 discovery settings, installed by provision-ros.sh at /etc/opendubs/ros-dds.env
# and read by every ROS unit (EnvironmentFile=). Every ROS participant runs on the Thor (the
# containers are host-network); off the robot, clients use rosbridge (:9090) or foxglove, never DDS.
# So discovery stays on loopback: with SUBNET (Jazzy's default) each participant multicast to
# 239.255.0.1:7400 on every interface, about 30 packets a second that the router sent out over the
# robot's Wi-Fi at the basic rate, about 13% of its airtime (2026-10-28).
#
# A LOCALHOST participant still finds a SUBNET one on the same host, so a unit or container that
# doesn't read this file yet keeps working; it just keeps multicasting.
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
