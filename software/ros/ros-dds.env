# The robot's ROS 2 DDS settings, installed by provision-ros.sh at /etc/opendubs/ros-dds.env and
# read by every ROS unit (EnvironmentFile=). The profile (fastdds-robot.xml) keeps DDS on UDP over
# loopback: no shared memory, and no discovery multicast onto the robot's Wi-Fi.
FASTRTPS_DEFAULT_PROFILES_FILE=/etc/opendubs/fastdds-robot.xml
FASTDDS_DEFAULT_PROFILES_FILE=/etc/opendubs/fastdds-robot.xml
# SUBNET, Jazzy's default, said explicitly: LOCALHOST would add a shared-memory transport on top of
# the profile. The profile already keeps discovery on the Thor.
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
