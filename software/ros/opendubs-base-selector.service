[Unit]
Description=OpenDubs base selector (one software owner of the base at a time: /base/claim, /base/<owner>/cmd_vel)
After=network.target
Before=opendubs-drive-bridge.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
# UDP DDS only: a long-lived participant on shared memory can go deaf (workplan L.10), and owners may
# run as other users or in containers.
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/etc/opendubs-fastdds-udp-only.xml
Environment=FASTDDS_DEFAULT_PROFILES_FILE=/etc/opendubs-fastdds-udp-only.xml
ExecStart=/opt/opendubs/ros/base-selector.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
