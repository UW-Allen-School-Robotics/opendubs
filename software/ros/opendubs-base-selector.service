[Unit]
Description=OpenDubs base selector (one software owner of the base at a time: /base/claim, /base/<owner>/cmd_vel)
After=network.target
Before=opendubs-drive-bridge.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
# The robot's DDS settings (ros-dds.env, installed by provision-ros.sh): UDP over loopback only, so
# no shared memory (a long-lived subscriber on it can go deaf, workplan L.10) and no multicast.
EnvironmentFile=/etc/opendubs/ros-dds.env
ExecStart=/opt/opendubs/ros/base-selector.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
