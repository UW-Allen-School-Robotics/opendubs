[Unit]
Description=OpenDubs floor frames (building plan frame -> map, and the plan's room labels)
After=network.target
# Only where a site file exists (it names the map and its fit to the building plan, floorplan.py)
# AND our SLAM is on: the floor frame hangs off OUR map frame, so a robot running another SLAM
# turns both off with the one flag.
ConditionPathExists=/var/lib/opendubs/maps/site.yaml
ConditionPathExists=/etc/opendubs/slam.enabled
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
# The robot's DDS settings (ros-dds.env, installed by provision-ros.sh): UDP over loopback only, so
# no shared memory (a long-lived subscriber on it can go deaf, workplan L.10) and no multicast.
EnvironmentFile=/etc/opendubs/ros-dds.env
ExecStart=/opt/opendubs/ros/floor-frames.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
