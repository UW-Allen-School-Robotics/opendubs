[Unit]
Description=OpenDubs skeleton feed relay (tracker topic -> dashboard -> stage page; skeleton points only)
After=network.target opendubs-dash.service
Wants=opendubs-dash.service
# Idle until the choreography lane's adapter is deployed: it names the message type to relay.
ConditionPathExists=/opt/opendubs/choreo/skeleton_feed.py
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
# The robot's DDS settings (ros-dds.env, installed by provision-ros.sh): UDP over loopback only, so
# no shared memory (a long-lived subscriber on it can go deaf, workplan L.10) and no multicast.
EnvironmentFile=/etc/opendubs/ros-dds.env
Environment=OPENDUBS_CHOREO=/opt/opendubs/choreo
ExecStart=/opt/opendubs/ros/skeleton-relay.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
