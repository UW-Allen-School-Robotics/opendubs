[Unit]
Description=OpenDubs SLAM (slam_toolbox on the front scan: localizes on the site map, else maps)
After=network.target opendubs-robot-state-publisher.service opendubs-drive-bridge.service opendubs-rplidar.service
# Off until a robot opts in: sudo touch /etc/opendubs/slam.enabled && sudo systemctl start opendubs-slam
ConditionPathExists=/etc/opendubs/slam.enabled
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
# The robot's DDS settings (ros-dds.env, installed by provision-ros.sh): UDP over loopback only, so
# no shared memory (a long-lived subscriber on it can go deaf, workplan L.10) and no multicast.
EnvironmentFile=/etc/opendubs/ros-dds.env
ExecStart=/opt/opendubs/ros/slam.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
