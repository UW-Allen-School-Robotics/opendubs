[Unit]
Description=OpenDubs rosbridge websocket (ROS topics/services to the dashboard)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=emmar
Environment=HOME=/home/emmar
ExecStart=/opt/opendubs/ros/rosbridge.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
