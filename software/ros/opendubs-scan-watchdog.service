[Unit]
Description=OpenDubs /scan liveness watchdog (restarts the RPLIDAR driver if scans stop)
After=network.target opendubs-rplidar.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
EnvironmentFile=-/etc/opendubs/ros-dds.env
# UDP DDS only: a long-lived subscriber on shared memory can go deaf (workplan L.10). The profile is
# installed by software/choreo/deploy/provision-runner.sh.
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/etc/opendubs-fastdds-udp-only.xml
Environment=FASTDDS_DEFAULT_PROFILES_FILE=/etc/opendubs-fastdds-udp-only.xml
ExecStart=/opt/opendubs/ros/scan-watchdog.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
