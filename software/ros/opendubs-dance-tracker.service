[Unit]
Description=OpenDubs dance tracker (a show's DANCE targets + /odom -> /cmd_vel, closed loop)
After=network.target opendubs-drive-bridge.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
# The robot's DDS settings (ros-dds.env, installed by provision-ros.sh): UDP over loopback only, so
# no shared memory (a long-lived subscriber on it can go deaf, workplan L.10) and no multicast.
EnvironmentFile=/etc/opendubs/ros-dds.env
# The software speed cap and the speeds at it, per robot, SHARED with opendubs-drive-bridge so the two
# cannot disagree (drive_scale.py). Optional: without it, the scripts' defaults apply.
EnvironmentFile=-/etc/opendubs/base.env
ExecStart=/opt/opendubs/ros/dance-tracker.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
