[Unit]
Description=OpenDubs dance tracker (a show's DANCE targets + /odom -> /cmd_vel, closed loop)
After=network.target opendubs-drive-bridge.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@OPENDUBS_USER@
Environment=HOME=@OPENDUBS_HOME@
# UDP DDS only: a long-lived subscriber on shared memory can go deaf (workplan L.10).
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/etc/opendubs-fastdds-udp-only.xml
Environment=FASTDDS_DEFAULT_PROFILES_FILE=/etc/opendubs-fastdds-udp-only.xml
# MUST MATCH opendubs-drive-bridge.service: the speed at DRIVE 1.0, which /cmd_vel is scaled against.
Environment=OPENDUBS_MAX_LIN=0.5
Environment=OPENDUBS_MAX_ANG=1.0
ExecStart=/opt/opendubs/ros/dance-tracker.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
