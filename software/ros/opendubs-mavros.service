[Unit]
Description=OpenDubs MAVROS (Pixhawk → /mavros topics + UDP forward to the dashboard)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=emmar
Environment=HOME=/home/emmar
ExecStart=/opt/opendubs/ros/mavros.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
