[Unit]
Description=OpenDubs robot_state_publisher (the robot's frames from opendubs.urdf, in /opendubs)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=emmar
Environment=HOME=/home/emmar
# UDP DDS only: a long-lived participant on shared memory can go deaf (workplan L.10).
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/etc/opendubs-fastdds-udp-only.xml
Environment=FASTDDS_DEFAULT_PROFILES_FILE=/etc/opendubs-fastdds-udp-only.xml
ExecStart=/opt/opendubs/ros/robot-state-publisher.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
