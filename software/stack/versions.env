# The stack's pins -- workplan-thor-stack 1.2. Every image reference in the repo resolves through
# this file; nothing carries its own copy of a digest. Plain KEY=value, so both a shell
# (`. versions.env`) and `docker --env-file` can read it. NO inline comments: --env-file would
# take them as part of the value.
#
# EMPTY VALUES ARE DELIBERATE. A build that reads an empty or tag-only (non-@sha256) image value
# must REFUSE, not fall back to :latest. Values are filled from the non-robot Thor once T-1a is
# settled (the first session there), each with the date it was captured.

# --- Platform (host) ------------------------------------------------------------------------
# What the host must be on. Checked by provisioning and by tools/deploy-audit.py, not by builds.
# e.g. R38.4 or R39.2 -- T-1a decides which the stack targets first
L4T_RELEASE=
# nvidia-container-toolkit; >= 1.17.7 for Thor's csv mode
CONTAINER_TOOLKIT_VERSION=

# --- ROS ------------------------------------------------------------------------------------
# decided, T-1
ROS_DISTRO=jazzy
# Lean base for CPU-only modules (bridges, the arm stack): no CUDA, so it runs on any JetPack
# line and on Orin unchanged.
# Captured 2026-10-08 from Docker Hub: the multi-arch INDEX digest (linux/amd64 + linux/arm64/v8),
# so the same pin builds on the Thor, an Orin and a dev machine. arm64 image created 2026-10-02.
ROS_BASE_IMAGE=ros:jazzy-ros-base@sha256:066420e07f60aa18262f2479981def87ebcfcec42eefb0c0c57c4a46098348ca

# --- NVIDIA / Isaac ROS (GPU modules) --------------------------------------------------------
# isaac-ros-cli / Isaac ROS release, e.g. 4.6.x (T-1)
ISAAC_ROS_RELEASE=
# NVIDIA's own input to the Isaac ROS base (cuda-dl-base on 4.2; base/ubuntu on 4.6). Recorded so
# a rebuild of our base is reproducible; downstream images do NOT build FROM it directly.
# nvcr.io/nvidia/...@sha256:...
ISAAC_ROS_UPSTREAM_IMAGE=
# OUR built Isaac ROS base (CLI image-key layering), pushed to a registry. GPU modules FROM this.
# <registry>/opendubs-isaac-ros-base@sha256:...
ISAAC_ROS_BASE_IMAGE=

# --- Services run from upstream images (never rebuilt, never redistributed) -----------------
# The AirPlay-compatible receiver (software/stack/airplay). Official image, multi-arch INDEX
# digest, captured 2026-10-14 (arm64 build created 2026-10-14). Carries GPL-2.0 nqptp and busybox:
# pulled by each robot, NEVER bundled into anything we ship (software/stack/airplay/README.md).
SHAIRPORT_IMAGE=mikebrady/shairport-sync@sha256:ff6235d83fa10c78600f4c7c803f33825bd050df3e7c3c60cc94b3572569d6d6
# The voice lane's local language model server (software/voice/image/run-llm.sh): NVIDIA AI-IOT's
# Jetson build of vLLM 0.19.0 for R38 / CUDA 13.0, published 2026-04-06. A single arm64 manifest,
# not an index: it runs on a Thor only. Both tags latest-jetson-thor and
# 0.19.0-r38.2.arm64-sbsa-cu130-24.04 resolved to this digest on 2026-10-19 (14.6 GB compressed).
# vLLM is Apache-2.0; the image also carries NVIDIA's CUDA libraries under NVIDIA's own licence, so it
# is pulled by each robot and NEVER bundled into anything we ship.
VOICE_LLM_IMAGE=ghcr.io/nvidia-ai-iot/vllm@sha256:b587dd56b4cb076209ad5156a626ac75f5a976d0e8e7d1e6a9fccd56d1bd65e8

# --- Build artifacts kept as release assets ------------------------------------------------------
# The face page's wake-word spotter (software/face-web/vendor/kws, git-ignored): the output of
# software/face-web/kws/build-kws.sh, whose VERSION stamp names its inputs (sherpa-onnx v1.13.8,
# emsdk 4.0.23, the int8 gigaspeech KWS model f170013b). Kept as an asset of this repository's GitHub
# release KWS_RELEASE_TAG, so a deploy from any checkout gets the same files without the 20-minute
# build. deploy-all.sh fetches it only when the checkout's build-kws.sh --check fails, verifies this
# sha256 and runs the check again. Sherpa-onnx and the model are Apache-2.0 (LICENSE inside).
# A new build-kws.sh stamp needs a new release asset and these two values, together.
KWS_RELEASE_TAG=kws-sherpa-onnx-v1.13.8-f170013b
KWS_ARTIFACT_SHA256=ac9b1f741084af8f864a28941a93604b235c68f498dca4869b9b03cd97f7fb95
