# The stack's pins -- workplan-thor-stack 1.2. Every image reference in the repo resolves through
# this file; nothing carries its own copy of a digest. Plain KEY=value, so both a shell
# (`. versions.env`) and `docker --env-file` can read it. NO inline comments: --env-file would
# take them as part of the value.
#
# EMPTY VALUES ARE DELIBERATE. A build that reads an empty or tag-only (non-@sha256) image value
# must REFUSE, not fall back to :latest. Values are filled from the non-robot Thor once T-1a is
# settled (the first session there), each with the date it was captured.

# --- Platform (host) ------------------------------------------------------------------------
# What the host must be on. Checked by provisioning and by tools/deploy-audit.py, not by builds.
# e.g. R38.4 or R39.2 -- T-1a decides which the stack targets first
L4T_RELEASE=
# nvidia-container-toolkit; >= 1.17.7 for Thor's csv mode
CONTAINER_TOOLKIT_VERSION=

# --- ROS ------------------------------------------------------------------------------------
# decided, T-1
ROS_DISTRO=jazzy
# Lean base for CPU-only modules (bridges, the arm stack): no CUDA, so it runs on any JetPack
# line and on Orin unchanged.
# Captured 2026-10-08 from Docker Hub: the multi-arch INDEX digest (linux/amd64 + linux/arm64/v8),
# so the same pin builds on the Thor, an Orin and a dev machine. arm64 image created 2026-10-02.
ROS_BASE_IMAGE=ros:jazzy-ros-base@sha256:066420e07f60aa18262f2479981def87ebcfcec42eefb0c0c57c4a46098348ca

# --- NVIDIA / Isaac ROS (GPU modules) --------------------------------------------------------
# isaac-ros-cli / Isaac ROS release, e.g. 4.6.x (T-1)
ISAAC_ROS_RELEASE=
# NVIDIA's own input to the Isaac ROS base (cuda-dl-base on 4.2; base/ubuntu on 4.6). Recorded so
# a rebuild of our base is reproducible; downstream images do NOT build FROM it directly.
# nvcr.io/nvidia/...@sha256:...
ISAAC_ROS_UPSTREAM_IMAGE=
# OUR built Isaac ROS base (CLI image-key layering), pushed to a registry. GPU modules FROM this.
# <registry>/opendubs-isaac-ros-base@sha256:...
ISAAC_ROS_BASE_IMAGE=
