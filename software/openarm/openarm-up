#!/bin/bash
# openarm-up — start, arm, and stop the OpenArm arm stack (impedance control) on this robot.
#
#   openarm-up                  launch the stack with both arms INACTIVE (motors off, limp)
#   openarm-up activate ARM     power one arm and start its controllers: left | right | both
#                               (the arm then moves itself to its zero pose over ~2 s).
#                               Starts the stack first if it is not running.
#                               Starts the arm's GRIPPER controller too — teleop needs it.
#   openarm-up park ARM         move to the stow pose so going limp is harmless: left | right | both
#   openarm-up hold ARM         stop where it is: drives the arm to its CURRENT pose, which
#                               preempts any running trajectory without moving anything
#   openarm-up down [--drop]    controllers off, arms inactive, stack stopped, motors verified off.
#                               REFUSES while an arm is active, because inactive = limp = the arm
#                               falls from wherever it is. Park first, or pass --drop deliberately.
#   openarm-up status           links, container, stack, hardware + controller states, motors
#   openarm-up logs             follow the current launch log
#
# Boot already provides the pieces this relies on: the peak_usb driver (DKMS), CAN channels
# named arm_left / arm_right and raised at 1M/5M CAN-FD (70-openarm-can.rules +
# openarm-can@.service), and the `openarm` container (restart unless-stopped).
# Activation is deliberately a separate, explicit step: the arms never power up by themselves.
# See docs/openarm-setup.md.
set -o pipefail

CONTAINER=openarm
LAUNCH_MATCH="ros2 launch openarm_impedance_controller"
LAUNCH="ros2 launch openarm_impedance_controller openarm_impedance_control.launch.py left_can_interface:=arm_left right_can_interface:=arm_right"
ROS="source /opt/ros/jazzy/setup.bash && source /openarm_ws/install/setup.bash"

# RMW the arm stack runs under. The container image bakes RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# into its Config.Env, but the HOST runs the Jazzy default (FastDDS) and has no cyclonedds
# installed — so host-side nodes (rosbridge on 9090, foxglove, the drive bridge) could not see a
# single arm topic. Cross-vendor DDS discovery is not a supported ROS 2 configuration, and the
# tablet needs /joint_states, so the two have to agree.
#
# Matching the CONTAINER to the host, rather than the reverse: FastDDS is already installed in the
# container (nothing to add), while switching the host would change the transport under a live
# dashboard, LIDAR and StamPLC bridge. Overridden per-exec rather than by recreating the container,
# so it is reversible and the image stays as upstream built it.
#
# Set OPENARM_RMW=rmw_cyclonedds_cpp to go back — the arm stack's hw_validation stages were run
# under cyclonedds, so if arm control misbehaves, that is the first thing to try.
OPENARM_RMW="${OPENARM_RMW:-rmw_fastrtps_cpp}"

# FastDDS must also be told NOT to use shared memory, or matching the RMW accomplishes nothing.
# The container runs with IpcMode=private, so its /dev/shm is a separate 64 MB filesystem from the
# host's (different device number; host is a 62 GB tmpfs). FastDDS discovers over UDP — which works,
# because --network=host shares the netns — and then advertises SHM locators for data transfer that
# the host cannot open. The failure is therefore SILENT AND CONFUSING: `ros2 topic list` and
# `topic info` on the host show the topic with a publisher, while `topic echo` blocks forever.
#
# This is very likely why the container shipped with CycloneDDS, which does not use SHM by default
# and so crosses the boundary unaided.
#
# Forcing UDPv4 costs little at joint-state message sizes. The durable alternative is to recreate
# the container with --ipc=host, which keeps the faster SHM path; this way needs no recreation.
FASTDDS_PROFILE=/etc/opendubs-fastdds-udp-only.xml
DOCKER_ENV=(-e "RMW_IMPLEMENTATION=$OPENARM_RMW")
if [ "$OPENARM_RMW" = rmw_fastrtps_cpp ]; then
  DOCKER_ENV+=(-e "FASTDDS_DEFAULT_PROFILES_FILE=$FASTDDS_PROFILE"
               -e "FASTRTPS_DEFAULT_PROFILES_FILE=$FASTDDS_PROFILE")
fi

# Written into the container rather than mounted, so this needs no change to how the container was
# created. Re-created on demand: a container rebuild drops it, and this puts it back.
ensure_fastdds_profile() {
  [ "$OPENARM_RMW" = rmw_fastrtps_cpp ] || return 0
  sudo docker exec "$CONTAINER" test -s "$FASTDDS_PROFILE" 2>/dev/null && return 0
  sudo docker exec "$CONTAINER" bash -c "cat > $FASTDDS_PROFILE" <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<!-- Forces UDPv4 and disables the built-in shared-memory transport. The container's /dev/shm is
     not the host's, so SHM locators advertised here are unusable from outside the container. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_only</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_only_participant" is_default_profile="true">
      <rtps>
        <userTransports><transport_id>udp_only</transport_id></userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
XML
  echo "  wrote $FASTDDS_PROFILE in the container (FastDDS SHM disabled)"
}
LOGDIR=/openarm_ws/log/openarm-up                      # inside the container; host-mounted
MOTORS=/usr/local/lib/openarm/openarm-motors
# Stow pose lives OUTSIDE /opt/opendubs: deploy-all.sh rsyncs --delete over /opt/opendubs/openarm,
# which would eat it. Same lesson as the drive calibration in rc_serial_probe's main.cpp.
# Format, one or both lines, joint angles in DEGREES so they can be eyeballed against
# `openarm-motors status`:   LEFT_STOW=0,-20,0,95,0,15,0
STOW_CONF=${OPENARM_STOW_CONF:-/etc/opendubs/openarm-stow.conf}

die() { echo "openarm-up: $*" >&2; exit 1; }
ros() { sudo docker exec "${DOCKER_ENV[@]}" "$CONTAINER" bash -c "$ROS && $*" | sed 's/\x1b\[[0-9;]*m//g'; }
running() { sudo docker exec "$CONTAINER" pgrep -f "$LAUNCH_MATCH" >/dev/null 2>&1; }

hw_state() {   # hw_state left|right  ->  active | inactive | unconfigured | ... | "" if unknown
  ros "timeout 15 ros2 control list_hardware_components 2>/dev/null" |
    awk -v n="openarm_$1_hardware_interface" 'index($0,n){f=1} f && /state:/{print $NF; exit}' |
    sed 's/.*label=//'
}

controller_state() { # controller_state <name>  ->  active | inactive | "" if not loaded
  ros "timeout 15 ros2 control list_controllers 2>/dev/null" | awk -v c="$1" '$1==c{print $NF}'
}

ctrl_state() { controller_state "${1}_controller"; }   # the ARM controller, by side

# Bring one controller to active, whether it is unloaded or merely inactive.
#
# ONE CONTROLLER PER CALL, always: `ros2 control switch_controllers` is ATOMIC, so a single call
# naming several fails ENTIRELY if any one of them is unknown — and leaves the rest untouched.
# On 2026-10-02 asking for both grippers at once failed on right_gripper_controller (declared in
# the controller YAML but never spawned) and therefore left left_gripper_controller inactive too,
# which read as the LEFT gripper being broken rather than the right being absent.
ensure_controller() {
  local name=$1 cs
  cs=$(controller_state "$name")
  if [ -z "$cs" ]; then
    # Declared in the YAML but never spawned — load_controller, not switch_controllers.
    ros "timeout 30 ros2 control load_controller --set-state active $name 2>&1" | tail -1 | sed 's/^/  /'
  elif [ "$cs" != active ]; then
    ros "timeout 30 ros2 control switch_controllers --activate $name 2>&1" | tail -1 | sed 's/^/  /'
  fi
  cs=$(controller_state "$name")
  [ "$cs" = active ]
}

check_links() {
  local i ok=0
  for i in arm_left arm_right; do
    local d; d=$(ip -details link show "$i" 2>/dev/null) || { echo "  $i: MISSING (driver loaded? adapter plugged in?)"; ok=1; continue; }
    local st; st=$(grep -oE "state (ERROR-[A-Z]+|BUS-OFF|STOPPED)" <<<"$d" | head -1)
    if grep -q "<.*UP.*>" <<<"$d" && [ "$st" = "state ERROR-ACTIVE" ]; then echo "  $i: up, $st"
    else echo "  $i: NOT READY ($st) — try: sudo systemctl restart openarm-can@$i"; ok=1; fi
  done
  return $ok
}

ensure_container() {
  local s; s=$(sudo docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null) || die "no '$CONTAINER' container"
  if [ "$s" != running ]; then echo "  starting container"; sudo docker start "$CONTAINER" >/dev/null || die "container would not start"; fi
}

cmd_start() {
  echo "== CAN links"; check_links || die "CAN links not ready — nothing launched"
  echo "== container"; ensure_container; echo "  $CONTAINER running"
  # `running` tests for the LAUNCH process, which outlives a SIGKILLed ros2_control_node — so a
  # half-dead stack looks "already running" while nothing answers, and activate then fails with
  # "rcl node's context is invalid". Name that state instead of refusing opaquely.
  if running; then
    if cm_reachable; then
      die "stack is already running (openarm-up status / openarm-up down)"
    fi
    die "a DEAD stack is still holding the launch process — the controller_manager does not answer.
  Clear it first:  openarm-up down"
  fi
  ensure_fastdds_profile
  echo "== motors before launch: $($MOTORS summary)"
  local log="$LOGDIR/launch-$(date +%Y%m%d-%H%M%S).log"
  sudo docker exec "$CONTAINER" bash -c "mkdir -p $LOGDIR && ln -sfn $log $LOGDIR/latest.log"
  sudo docker exec -d "${DOCKER_ENV[@]}" "$CONTAINER" bash -c "$ROS && exec $LAUNCH > $log 2>&1"
  echo "== launched; waiting for both arms' hardware (log: openarm-up logs)"
  local t l r
  for t in $(seq 1 30); do
    sleep 1
    running || die "launch exited — see $log (inside the container)"
    l=$(hw_state left); r=$(hw_state right)
    [ -n "$l" ] && [ -n "$r" ] && break
  done
  echo "  left: ${l:-?}   right: ${r:-?}"
  if [ "$l" = active ] || [ "$r" = active ]; then
    echo "!! an arm came up ACTIVE by itself — the controller config no longer starts arms inactive."
    echo "!! stopping the stack now."; cmd_down; exit 1
  fi
  [ "$l" = inactive ] && [ "$r" = inactive ] || die "arms did not reach 'inactive' in 30 s — check openarm-up logs, then openarm-up down"
  echo "== motors: $($MOTORS summary)"
  echo "Ready. Arms are INACTIVE (limp). Next: openarm-up activate left|right|both"
}

activate_one() {
  local arm=$1
  local st; st=$(hw_state "$arm")
  if [ "$st" != active ]; then
    echo "== $arm: hardware $st -> active"
    ros "timeout 30 ros2 control set_hardware_component_state openarm_${arm}_hardware_interface active 2>&1" | tail -1 | sed 's/^/  /'
    st=$(hw_state "$arm")
    [ "$st" = active ] || die "$arm hardware is '$st', not active — stopping"
  fi
  # The motors do not all answer the instant the hardware goes active — the GRIPPER is reliably
  # last, and a single immediate read raced it: 2026-10-02 saw "only 7/8 ENABLED" with id 8
  # reporting `no reply`, which read as a wiring fault, while a read seconds later showed it
  # ENABLED and healthy. Poll instead of sampling once.
  local en=0 i
  for i in $(seq 1 10); do
    en=$($MOTORS status | awk -v b="arm_$arm" '/^arm_/{cur=$1} cur==b && /ENABLED/{n++} END{print n+0}')
    [ "$en" -eq 8 ] && break
    sleep 1
  done
  [ "$en" -eq 8 ] || die "$arm: only $en/8 motors report ENABLED after 10 s — not starting its controller.
  A motor stuck at 'no reply' is unpowered or its CAN wiring is broken at or before it; the gripper
  is last in the chain. Check with: openarm-motors status   (then: openarm-up down)"
  echo "  $arm: 8/8 motors ENABLED"
  local cs
  if ! ensure_controller "${arm}_controller"; then
    cs=$(controller_state "${arm}_controller")
    die "${arm}_controller is '${cs:-not loaded}', not active"
  fi
  echo "  ${arm}_controller: active"

  # The GRIPPER controller too. Not a nicety: the WebXR teleop opens a GripperCommand action
  # client per arm and will not start without one, dying 30 s later with
  # "Timed out waiting for left gripper action server" — a message that points at the wrong arm
  # and says nothing about controllers.
  #
  # A WARNING rather than fatal, because an arm is perfectly usable without its gripper and some
  # configurations may not declare one. But it says what it costs, so the teleop's timeout is
  # never the first time anyone hears about it.
  if ensure_controller "${arm}_gripper_controller"; then
    echo "  ${arm}_gripper_controller: active"
  else
    cs=$(controller_state "${arm}_gripper_controller")
    echo "  !! ${arm}_gripper_controller is '${cs:-not loaded}', not active."
    echo "  !! The arm will move, but TELEOP WILL NOT START — it waits on this arm's"
    echo "  !! GripperCommand action server and then times out."
  fi
}

cmd_activate() {
  local which=$1 arms
  case "$which" in left|right) arms=$which ;; both) arms="left right" ;; *) die "usage: openarm-up activate left|right|both" ;; esac
  # From the tablet there is no "start the stack" step: DE-ENERGIZE runs `down`, which stops the
  # whole stack, and ACTIVATE is the next button anyone presses. So bring the stack up first when it
  # is not running -- exactly `openarm-up`, arms INACTIVE, with all its checks -- then activate.
  if ! running; then
    echo "== stack not running — starting it first"
    cmd_start
  fi
  for a in $arms; do activate_one "$a"; done
  echo "== motors: $($MOTORS summary)"
}

# Joint names come from the LIVE controller rather than a hardcoded list: they are set by
# openarm_description, a submodule we track and do not own.
#
# NOT via `ros2 param get <ctrl> joints` — that returns "Node not found" on this stack, because
# the controller_manager does not appear in `ros2 node list` even though its services answer.
# `list_controllers -v` reports each controller's required command interfaces as
# <joint>/{position,velocity,effort} triples, so take the unique joint names in order.
joint_names() {
  ros "timeout 25 ros2 control list_controllers -v" |
    awk -v c="$1_controller" '$1==c{f=1;next} f && /^[^[:space:]]/{f=0} f' |
    grep -oE "openarm_$1_joint[0-9]+" | awk '!seen[$0]++' | paste -sd, -
}

stow_pose() {  # stow_pose left|right -> "d1,d2,..." in degrees, or "" if unconfigured
  [ -r "$STOW_CONF" ] || return 0
  local key; key=$(tr '[:lower:]' '[:upper:]' <<<"$1")_STOW
  sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$STOW_CONF" | tail -1 | tr -d ' '
}

# Is the arm already AT its stow pose? Without this, `down` refuses after a SUCCESSFUL park —
# the guard would only know "hardware is active", not "the arm is where it is meant to be
# de-energized", so the normal park-then-down flow would always need --drop and the flag would
# become reflex. Compared in degrees against openarm-motors, which is the same unit and mapping
# the stow file uses. Tolerance covers the steady-state error from imperfect gravity
# compensation, which measures ~1 deg here.
STOW_TOL_DEG="${OPENARM_STOW_TOL_DEG:-5}"
at_stow() {
  local arm=$1 want cur
  want=$(stow_pose "$arm"); [ -n "$want" ] || return 1
  cur=$($MOTORS status | awk -v b="arm_$arm" '/^arm_/{cur=$1} cur==b && /id [1-7] \(joint/{
          gsub(/\+/,"",$7); printf "%s%s",(n++?",":""),$7}')
  [ -n "$cur" ] || return 1
  awk -v w="$want" -v c="$cur" -v tol="$STOW_TOL_DEG" 'BEGIN{
    nw=split(w,W,","); nc=split(c,C,",");
    if (nw != nc || nw == 0) exit 1;
    for (i=1;i<=nw;i++) { d=W[i]-C[i]; if (d<0) d=-d; if (d>tol) exit 1 }
    exit 0 }'
}

# Moving an arm on the way DOWN is as hazardous as moving it on the way UP, so parking is its own
# explicit step and is never folded into `down`.
# Current joint angles in degrees, joints 1-7, from openarm-motors. The mapping is identity --
# verified 2026-10-02: after driving to zero, all seven joints read ~0 in these units.
current_pose() {
  $MOTORS status | awk -v b="arm_$1" '/^arm_/{cur=$1} cur==b && /id [1-7] \(joint/{
      gsub(/\+/,"",$7); printf "%s%s",(n++?",":""),$7}'
}

# HOLD: drive the arm to WHERE IT ALREADY IS. That reads like a no-op and is not — sending a
# trajectory preempts whatever trajectory is currently running and leaves the arm commanded to its
# present pose, which is the "stop what you are doing without dropping anything" primitive. Short
# travel because it is not supposed to move.
cmd_hold() {
  local which=${1:-} arms a
  case "$which" in left|right) arms=$which ;; both) arms="left right" ;;
    *) die "usage: openarm-up hold left|right|both" ;; esac
  running || die "stack is not running — nothing to hold"
  for a in $arms; do
    [ "$(ctrl_state "$a")" = active ] || die "$a: controller is not active — nothing to hold"
    move_to "$a" "$(current_pose "$a")" 1 "holding at its current pose"
  done
}

park_one() {
  local arm=$1
  [ "$(ctrl_state "$arm")" = active ] || die "$arm: controller is not active — nothing to park (openarm-up activate $arm)"

  local deg; deg=$(stow_pose "$arm")
  [ -n "$deg" ] || die "$arm: no stow pose configured in $STOW_CONF.
  It is deliberately unset rather than guessed: a wrong pose drives the arm into the head
  (J2 ~182 deg with the elbow folded is a measured collision). Jog the arm to a pose it can be
  de-energized in, read the angles off \`openarm-motors status\`, and write:
      $(tr '[:lower:]' '[:upper:]' <<<"$arm")_STOW=<7 joint angles in degrees, comma-separated>"

  move_to "$arm" "$deg" "$PARK_SECS" "parking to [$deg] deg"
  echo "  Verify the arm is where you want it BEFORE openarm-up down."
}

# move_to <arm> <deg,deg,...> <secs> <what it is doing>
move_to() {
  local arm=$1 deg=$2 secs=$3 what=$4
  [ -n "$deg" ] || die "$arm: no target angles"

  local names; names=$(joint_names "$arm")
  [ -n "$names" ] || die "$arm: could not read joint names from ${arm}_controller"

  local nj nd
  nj=$(tr -cd , <<<"$names" | wc -c); nd=$(tr -cd , <<<"$deg" | wc -c)
  [ "$nj" -eq "$nd" ] || die "$arm: got $((nd+1)) angles but ${arm}_controller has $((nj+1)) joints"

  local rad; rad=$(awk -v s="$deg" 'BEGIN{n=split(s,a,",");for(i=1;i<=n;i++)printf "%s%.6f",(i>1?",":""),a[i]*3.14159265358979/180}')
  echo "== $arm: $what over ${secs}s — KEEP CLEAR"
  ros "timeout $((secs + 20)) ros2 action send_goal /${arm}_controller/follow_joint_trajectory \
control_msgs/action/FollowJointTrajectory \
'{trajectory: {joint_names: [$names], points: [{positions: [$rad], time_from_start: {sec: $secs}}]}}' 2>&1" \
    | tail -3 | sed 's/^/  /'
  echo "  $arm motors now:"; $MOTORS status | awk -v b="arm_$arm" '/^arm_/{cur=$1} cur==b' | sed 's/^/    /'
}

PARK_SECS=${OPENARM_PARK_SECS:-4}

cmd_park() {
  local which=${1:-} arms a
  case "$which" in left|right) arms=$which ;; both) arms="left right" ;;
    *) die "usage: openarm-up park left|right|both" ;; esac
  running || die "stack is not running — nothing to park"
  for a in $arms; do park_one "$a"; done
}

# Does the controller_manager still answer? After the stack dies — crash, pkill, a container that
# went away — it does not, and every `ros2 control` call then burns its FULL timeout (30 s each,
# per arm) failing at something that cannot succeed. On 2026-10-02 that made `down` take so long
# it was killed before reaching the direct-DISABLE fallback, leaving the arms ENERGIZED. Probe
# once, cheaply, and skip the graceful path when there is nothing to be graceful with.
cm_reachable() {
  sudo docker exec "${DOCKER_ENV[@]}" "$CONTAINER" bash -c \
    "$ROS && timeout 8 ros2 control list_controllers" >/dev/null 2>&1
}

cmd_down() {
  # An active arm is an ENERGIZED arm, and the first thing below takes that away. Report where each
  # arm is and refuse, rather than dropping something that may be extended or holding a load.
  # Probed ONCE: hw_state/ctrl_state each wait out a 15 s timeout against a dead controller_manager,
  # so asking per arm per check is how `down` ends up too slow to finish.
  local CM=dead
  if running && cm_reachable; then CM=alive; fi

  if [ "${DROP:-0}" != 1 ] && running && [ "$CM" = alive ]; then
    local a active=""
    # An arm already at its stow pose is fine to de-energize — that is what parking it was for.
    for a in left right; do
      [ "$(hw_state "$a")" = active ] || continue
      at_stow "$a" && { echo "  $a: at its stow pose — safe to de-energize"; continue; }
      active="$active $a"
    done
    if [ -n "$active" ]; then
      echo "openarm-up: refusing —$active still active, and 'inactive' removes torque:" >&2
      echo "  the arm goes limp and falls from wherever it is now." >&2
      for a in $active; do $MOTORS status | awk -v b="arm_$a" '/^arm_/{cur=$1} cur==b' | sed 's/^/    /' >&2; done
      echo "  Park it first:  openarm-up park${active// /,}" >&2
      echo "  Or, if it is already somewhere it can safely be dropped:  openarm-up down --drop" >&2
      exit 1
    fi
  fi
  if running && [ "$CM" = dead ]; then
    echo "!! the controller_manager is not answering — the stack is dead, not running cleanly."
    # The ROS-side refusal above could not run, so guard here instead using the CAN path, which
    # does not depend on the stack being alive. This is the DANGEROUS case: the DAMIAO motors have
    # no command timeout (verified 2026-10-02 — they held position and stayed ENABLED 20 s after
    # the control node was SIGKILLed), so a stack that died mid-motion has left the arm ENERGIZED
    # and frozen at an arbitrary pose. Disabling here drops it from there.
    if [ "${DROP:-0}" != 1 ] && ! $MOTORS summary | grep -q "enabled=0 "; then
      echo "openarm-up: refusing — motors are still ENERGIZED with no controller:" >&2
      $MOTORS summary | sed "s/^/    /" >&2
      echo "  The stack died without disabling them, and they hold their last command forever." >&2
      echo "  Disabling now drops each arm from wherever it froze. Either:" >&2
      echo "    openarm-up down --drop     if the arms are somewhere safe to drop from, or" >&2
      echo "    openarm-up && openarm-up activate <arm> && openarm-up park <arm>" >&2
      echo "  — but note ACTIVATION DRIVES THE ARM TO ZERO, which from a frozen pose far from" >&2
      echo "  zero is a large unexpected sweep. Clear the workspace before choosing that." >&2
      exit 1
    fi
    echo "!! Skipping the ROS deactivation steps (they would each wait out their timeout) and"
    echo "!! going straight to disabling the motors over CAN."
    sudo docker exec "$CONTAINER" pkill -INT -f "$LAUNCH_MATCH" 2>/dev/null
    sleep 1
    sudo docker exec "$CONTAINER" pkill -TERM -f "ros2_control_node|$LAUNCH_MATCH" 2>/dev/null
  elif running; then
    local a c cs
    echo "== controllers off"
    # Grippers first, then arms, and one call each (switch_controllers is atomic). Leaving a
    # gripper controller active would keep it claiming its joint's interfaces while the hardware
    # is being taken inactive underneath it.
    for a in left right; do
      for c in "${a}_gripper_controller" "${a}_controller"; do
        [ "$(controller_state "$c")" = active ] || continue
        ros "timeout 30 ros2 control switch_controllers --deactivate $c 2>&1" | tail -1 | sed "s/^/  $c: /"
      done
    done
    echo "== arms inactive (limp)"
    for a in left right; do
      [ "$(hw_state "$a")" = active ] && ros "timeout 30 ros2 control set_hardware_component_state openarm_${a}_hardware_interface inactive 2>&1" | tail -1 | sed "s/^/  $a: /"
    done
    echo "== stopping the stack"
    sudo docker exec "$CONTAINER" pkill -INT -f "$LAUNCH_MATCH"
    for _ in $(seq 1 10); do running || break; sleep 1; done
    running && { echo "  still running after 10 s — terminating"; sudo docker exec "$CONTAINER" pkill -TERM -f "ros2_control_node|$LAUNCH_MATCH"; sleep 2; }
  else
    echo "== stack not running"
  fi
  local c; c=$($MOTORS summary)
  if grep -q "enabled=0 " <<<"$c "; then echo "== motors: $c"; return 0; fi
  echo "!! motors still enabled after shutdown ($c) — sending DISABLE directly"
  $MOTORS disable && echo "== motors: $($MOTORS summary)" || { echo "!! MOTORS STILL ENABLED — cut arm power"; return 1; }
}

cmd_status() {
  echo "== CAN links"; check_links
  echo "== container: $(sudo docker ps -a --filter name="^${CONTAINER}\$" --format '{{.Status}}')"
  if running; then
    echo "== stack: running"
    local a
    for a in left right; do echo "  $a: hardware $(hw_state $a)   controller $(ctrl_state $a || true)"; done
  else
    echo "== stack: not running"
  fi
  echo "== motors"; $MOTORS status | sed 's/^/  /'
}

case "${1:-start}" in
  start|up) cmd_start ;;
  activate) cmd_activate "$2" ;;
  park) cmd_park "${2:-}" ;;
  hold) cmd_hold "${2:-}" ;;
  down|stop) shift; [ "${1:-}" = --drop ] && DROP=1; cmd_down ;;
  status) cmd_status ;;
  logs) sudo docker exec -it "$CONTAINER" tail -n 200 -F "$LOGDIR/latest.log" ;;
  -h|--help|help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (openarm-up help)" ;;
esac
