# Versions of what the openarm image installs beyond the base, so a rebuild installs the same.
# Written by capture-pins.sh from a robot whose arm stack is known good; build.sh refuses while
# any value is empty. The base image itself is ROS_BASE_IMAGE in software/stack/versions.env.

# libopenarm-can-dev and openarm-can-utils, from ppa:openarm/main
OPENARM_CAN_VERSION=
# uv, which builds the workspace's Python environment
UV_VERSION=
