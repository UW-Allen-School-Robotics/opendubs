# Versions of what the openarm image installs beyond the base, so a rebuild installs the same.
# build.sh refuses while any value is empty. The base image itself is ROS_BASE_IMAGE in
# software/stack/versions.env. capture-pins.sh compares these with a robot's running container.

# The OpenArm CAN library (enactic/openarm_can) and its command-line tools, built from source at the
# commit its 1.4.0 tag points to: the release opendubs2 runs. Built rather than installed from
# ppa:openarm/main because the PPA keeps only its latest build, so a pinned version vanishes from it.
OPENARM_CAN_COMMIT=f340d4b808fb177e1f297af54eb55fd51c6c7c10
# uv, which builds the workspace's Python environment: what opendubs2 runs (capture-pins.sh, 2026-10-09),
# and the version workspace/uv.lock was made with.
UV_VERSION=0.12.17
