# Versions of what the openarm image installs beyond the base, so a rebuild installs the same.
# build.sh refuses while any value is empty. The base image itself is ROS_BASE_IMAGE in
# software/stack/versions.env. capture-pins.sh compares these with a robot's running container.

# libopenarm-can-dev and openarm-can-utils, from ppa:openarm/main: the noble (Ubuntu 24.04) build of
# the library's 1.4.0 release, the PPA's current version (published 2026-09-16).
OPENARM_CAN_VERSION=1.4.0-1.ubuntu24.04.1
# uv, which builds the workspace's Python environment. The version workspace/uv.lock was made with.
UV_VERSION=0.11.21
