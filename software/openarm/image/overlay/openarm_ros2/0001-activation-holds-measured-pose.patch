+// Activation that holds where the arm is, instead of driving it to zero.
+//
+// Upstream's on_activate enables every motor, sends one full-stiffness command to 0 rad, then ramps
+// every joint to zero over 2 s and snaps the gripper, so activating an arm left anywhere but zero
+// sweeps it. This holds the pose the arm is measured at: read twice, check the reads, then command
+// exactly that pose while the stiffness ramps up from zero. The checks and the ramp are pure, here,
+// so they can be tested without a robot (test/test_activation_hold.cpp).
+//
+// What the checks cannot see: a motor that answered once and then went silent keeps its last
+// reading, and the library keeps no timestamp. Two agreeing reads from such a motor still pass.
+// The caller's enable check (every motor reports enabled afterwards) is what catches it.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace openarm_hardware {
+namespace activation_hold {
+
+// Two reads of one joint, a refresh apart, must agree this closely (about 1 degree).
+constexpr double kAgreeTolRad = 0.0175;
+// The stiffness ramp: kRampSteps steps of kRampStepMs, 0.5 s in all.
+constexpr int kRampSteps = 50;
+constexpr int kRampStepMs = 10;
+// For log messages.
+constexpr double kRadToDeg = 180.0 / 3.14159265358979323846;
+// A joint that moved more than this while activating is logged as a warning (about 3 degrees).
+constexpr double kMovedWarnRad = 0.0524;
+
+struct Check {
+  bool ok;
+  std::string reason;
+};
+
+// Before enabling. Every motor must have answered -- a DAMIAO reply carries the MOS temperature, so a
+// motor that never replied reads 0 -- none may report an error, and two reads one refresh apart must
+// agree. A hold commanded from a stale or wrong reading is the one way this activation could still
+// move the arm, so a doubtful reading refuses rather than guessing.
+inline Check check_reads(const std::vector<double>& first, const std::vector<double>& second,
+                         const std::vector<int>& tmos, const std::vector<bool>& error,
+                         double tol = kAgreeTolRad) {
+  const std::size_t n = first.size();
+  if (n == 0 || second.size() != n || tmos.size() != n || error.size() != n) {
+    return {false, "the motor reads are incomplete"};
+  }
+  for (std::size_t i = 0; i < n; ++i) {
+    const std::string id = "motor " + std::to_string(i + 1);
+    if (tmos[i] <= 0) return {false, id + " has not answered"};
+    if (error[i]) return {false, id + " reports an error"};
+    if (!std::isfinite(first[i]) || !std::isfinite(second[i])) {
+      return {false, id + " reports a position that is not a number"};
+    }
+    if (std::fabs(first[i] - second[i]) > tol) {
+      return {false, id + " moved between two reads, so its position cannot be trusted"};
+    }
+  }
+  return {true, ""};
+}
+
+// The stiffness at ramp step `step` of `steps`: 0 at step 0, rising linearly to `full` at the last.
+inline double ramp_gain(double full, int step, int steps = kRampSteps) {
+  if (steps <= 0) return full;
+  const double t = std::clamp(static_cast<double>(step) / static_cast<double>(steps), 0.0, 1.0);
+  return full * t;
+}
+
+// The largest |a[i] - b[i]|; for reporting how far activation moved the arm.
+inline double max_abs_diff(const std::vector<double>& a, const std::vector<double>& b) {
+  double worst = 0.0;
+  const std::size_t n = std::min(a.size(), b.size());
+  for (std::size_t i = 0; i < n; ++i) worst = std::max(worst, std::fabs(a[i] - b[i]));
+  return worst;
+}
+
+}  // namespace activation_hold
+}  // namespace openarm_hardware
