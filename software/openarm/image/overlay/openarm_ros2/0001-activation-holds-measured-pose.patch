+
+void OpenArmHW::read_measured(std::vector<double>& pos, std::vector<int>& tmos,
+                              std::vector<bool>& error) {
+  openarm_->refresh_all();
+  std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  openarm_->recv_all();
+  pos.clear();
+  tmos.clear();
+  error.clear();
+  const auto& arm_motors = openarm_->get_arm().get_motors();
+  for (size_t i = 0; i < ARM_DOF && i < arm_motors.size(); ++i) {
+    pos.push_back(arm_motors[i].get_position());
+    tmos.push_back(arm_motors[i].get_state_tmos());
+    error.push_back(arm_motors[i].has_error());
+  }
+  if (hand_) {
+    const auto& gripper_motors = openarm_->get_gripper().get_motors();
+    if (!gripper_motors.empty()) {
+      pos.push_back(gripper_motors[0].get_position());
+      tmos.push_back(gripper_motors[0].get_state_tmos());
+      error.push_back(gripper_motors[0].has_error());
+    }
+  }
+}
+
+void OpenArmHW::hold_with_stiffness_ramp(const std::vector<double>& hold) {
+  namespace ah = openarm_hardware::activation_hold;
+  const bool gripper = hand_ && hold.size() > ARM_DOF;
+  auto send = [&](int step) {
+    std::vector<openarm::damiao_motor::MITParam> arm_params;
+    for (size_t i = 0; i < ARM_DOF; ++i) {
+      arm_params.push_back({ah::ramp_gain(kp_[i], step), kd_[i], hold[i], 0.0, 0.0});
+    }
+    openarm_->get_arm().mit_control_all(arm_params);
+    if (gripper) {
+      openarm_->get_gripper().mit_control_all(
+          {{ah::ramp_gain(gripper_kp_, step), gripper_kd_, hold[ARM_DOF], 0.0, 0.0}});
+    }
+    openarm_->recv_all();
+  };
+  // A zero-stiffness command at the hold pose before AND straight after enabling, so the first
+  // command a freshly enabled motor acts on is "stay here, softly", never an older setpoint.
+  send(0);
+  openarm_->enable_all();
+  std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  openarm_->recv_all();
+  for (int step = 0; step <= ah::kRampSteps; ++step) {
+    send(step);
+    std::this_thread::sleep_for(std::chrono::milliseconds(ah::kRampStepMs));
+  }
 }
 
