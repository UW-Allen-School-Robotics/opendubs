+// Tests for activation_hold.hpp, the checks and the ramp behind "activation holds where the arm
+// is". Plain C++17 and no ROS, so it runs anywhere:
+//   c++ -std=c++17 -I include test/test_activation_hold.cpp -o /tmp/t && /tmp/t
+#include <cmath>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+#include "openarm_hardware/activation_hold.hpp"
+
+namespace ah = openarm_hardware::activation_hold;
+
+static int failures = 0;
+static void expect(bool cond, const char* what) {
+  std::printf("  %s  %s\n", cond ? "ok  " : "FAIL", what);
+  if (!cond) ++failures;
+}
+
+int main() {
+  const std::vector<double> pose = {0.1, -0.2, 0.3, 0.5, -0.1, 0.0, 0.05, 0.4};  // 7 joints + gripper
+  const std::vector<int> warm(8, 27);
+  const std::vector<bool> clean(8, false);
+
+  expect(ah::check_reads(pose, pose, warm, clean).ok, "two agreeing reads from answering motors pass");
+
+  std::vector<double> nudged = pose;
+  nudged[3] += 0.01;  // ~0.6 deg: read noise
+  expect(ah::check_reads(pose, nudged, warm, clean).ok, "reads within 1 deg pass");
+
+  std::vector<double> moved = pose;
+  moved[3] += 0.03;  // ~1.7 deg between two reads one refresh apart
+  auto c = ah::check_reads(pose, moved, warm, clean);
+  expect(!c.ok && c.reason.find("motor 4") != std::string::npos, "reads 1.7 deg apart refuse, naming motor 4");
+
+  std::vector<int> silent = warm;
+  silent[7] = 0;  // the gripper never replied
+  c = ah::check_reads(pose, pose, silent, clean);
+  expect(!c.ok && c.reason.find("motor 8 has not answered") != std::string::npos,
+         "a motor that never answered refuses");
+
+  std::vector<bool> faulted = clean;
+  faulted[1] = true;
+  c = ah::check_reads(pose, pose, warm, faulted);
+  expect(!c.ok && c.reason.find("motor 2 reports an error") != std::string::npos, "a motor in error refuses");
+
+  std::vector<double> nan_read = pose;
+  nan_read[0] = std::nan("");
+  expect(!ah::check_reads(nan_read, nan_read, warm, clean).ok, "a NaN position refuses");
+
+  expect(!ah::check_reads({}, {}, {}, {}).ok, "no reads at all refuses");
+  expect(!ah::check_reads(pose, std::vector<double>(7, 0.0), warm, clean).ok, "mismatched read sizes refuse");
+
+  expect(ah::ramp_gain(70.0, 0) == 0.0, "the ramp starts at zero stiffness");
+  expect(std::fabs(ah::ramp_gain(70.0, ah::kRampSteps) - 70.0) < 1e-12, "the ramp ends at the full gain");
+  expect(std::fabs(ah::ramp_gain(70.0, ah::kRampSteps / 2) - 35.0) < 1e-12, "the ramp is linear");
+  expect(ah::ramp_gain(70.0, ah::kRampSteps + 10) == 70.0, "past the last step it stays at the full gain");
+  expect(ah::ramp_gain(70.0, -3) == 0.0, "before the first step it stays at zero");
+  expect(ah::kRampSteps * ah::kRampStepMs == 500, "the ramp takes 0.5 s");
+
+  expect(std::fabs(ah::max_abs_diff(pose, moved) - 0.03) < 1e-12, "max_abs_diff finds the largest move");
+
+  std::printf("%s\n", failures ? "FAILED" : "all passed");
+  return failures ? 1 : 0;
+}
