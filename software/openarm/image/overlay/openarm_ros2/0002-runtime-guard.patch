+void OpenArmHW::guard_open() {
+  guard_close();
+  const auto log = rclcpp::get_logger("OpenArmHW");
+  guard_recv_ids_ = DEFAULT_RECV_CAN_IDS;
+  guard_motor_ids_.clear();
+  for (auto id : DEFAULT_SEND_CAN_IDS) guard_motor_ids_.push_back(static_cast<uint8_t>(id));
+  if (hand_) {
+    guard_recv_ids_.push_back(DEFAULT_GRIPPER_RECV_CAN_ID);
+    guard_motor_ids_.push_back(static_cast<uint8_t>(DEFAULT_GRIPPER_SEND_CAN_ID));
+  }
+  guard_obs_.assign(guard_recv_ids_.size(), {true, 0x1});
+
+  // Read-only: this socket never sends. SocketCAN gives every socket a copy of every frame, so it
+  // sees the replies openarm_can reads, without touching openarm_can.
+  const int s = ::socket(PF_CAN, SOCK_RAW, CAN_RAW);
+  if (s < 0) {
+    RCLCPP_WARN(log, "%s: runtime guard OFF, no socket: %s", can_interface_.c_str(), std::strerror(errno));
+    return;
+  }
+  const int on = 1;
+  if (can_fd_) ::setsockopt(s, SOL_CAN_RAW, CAN_RAW_FD_FRAMES, &on, sizeof(on));
+  std::vector<can_filter> filters;
+  for (auto id : guard_recv_ids_) filters.push_back({id, CAN_SFF_MASK});
+  ::setsockopt(s, SOL_CAN_RAW, CAN_RAW_FILTER, filters.data(),
+               static_cast<socklen_t>(filters.size() * sizeof(can_filter)));
+  ifreq ifr{};
+  std::strncpy(ifr.ifr_name, can_interface_.c_str(), IFNAMSIZ - 1);
+  sockaddr_can addr{};
+  addr.can_family = AF_CAN;
+  if (::ioctl(s, SIOCGIFINDEX, &ifr) < 0 ||
+      (addr.can_ifindex = ifr.ifr_ifindex,
+       ::bind(s, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0)) {
+    RCLCPP_WARN(log, "%s: runtime guard OFF, cannot bind: %s", can_interface_.c_str(), std::strerror(errno));
+    ::close(s);
+    return;
+  }
+  ::fcntl(s, F_SETFL, ::fcntl(s, F_GETFL) | O_NONBLOCK);
+  guard_sock_ = s;
+}
+
+void OpenArmHW::guard_close() {
+  if (guard_sock_ >= 0) ::close(guard_sock_);
+  guard_sock_ = -1;
+}
+
+// Everything that arrived since the last cycle, without blocking. Bounded, so a flooded bus cannot
+// stall the control loop.
+void OpenArmHW::guard_poll() {
+  for (auto& o : guard_obs_) o.replied = false;
+  canfd_frame f{};
+  for (int n = 0; n < 256; ++n) {
+    const ssize_t got = ::read(guard_sock_, &f, sizeof(f));
+    if (got != static_cast<ssize_t>(CAN_MTU) && got != static_cast<ssize_t>(CANFD_MTU)) break;
+    if (f.can_id & (CAN_ERR_FLAG | CAN_RTR_FLAG | CAN_EFF_FLAG)) continue;
+    const uint32_t id = f.can_id & CAN_SFF_MASK;
+    for (size_t i = 0; i < guard_recv_ids_.size(); ++i) {
+      if (guard_recv_ids_[i] != id) continue;
+      const auto r = runtime_guard::parse_reply(guard_motor_ids_[i], f.data, f.len);
+      if (r.alive) guard_obs_[i].replied = true;
+      if (r.has_status) guard_obs_[i].status = r.status;
+      break;
+    }
+  }
+}
+
 }  // namespace openarm_hardware
 
