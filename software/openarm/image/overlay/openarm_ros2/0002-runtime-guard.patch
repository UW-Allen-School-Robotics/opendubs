diff --git a/openarm_hardware/test/test_runtime_guard.cpp b/openarm_hardware/test/test_runtime_guard.cpp
new file mode 100644
index 0000000..91789f0
--- /dev/null
+++ b/openarm_hardware/test/test_runtime_guard.cpp
@@ -0,0 +1,69 @@
+// The runtime guard's decisions, without a robot:
+//   g++ -std=c++17 -I include test/test_runtime_guard.cpp -o /tmp/t && /tmp/t
+#include <cstdio>
+#include <vector>
+
+#include "openarm_hardware/runtime_guard.hpp"
+
+namespace rg = openarm_hardware::runtime_guard;
+
+static int fails = 0;
+static void expect(bool cond, const char* what) {
+  std::printf("  %s  %s\n", cond ? "ok  " : "FAIL", what);
+  fails += !cond;
+}
+
+static std::vector<rg::Obs> all(bool replied, uint8_t status = 0x1) {
+  return std::vector<rg::Obs>(8, {replied, status});
+}
+
+int main() {
+  {  // a healthy arm, with the odd missed cycle a busy bus produces, never holds
+    rg::Guard g(8);
+    bool held = false;
+    for (int c = 0; c < 2000; ++c) held |= g.observe(all(c % 7 != 0)).hold;
+    expect(!held, "an occasional missed reply does not hold the arm");
+  }
+  {  // 2026-10-17: the left gripper (motor 8) went silent while motors 1-7 answered
+    rg::Guard g(8);
+    auto obs = all(true);
+    obs[7].replied = false;
+    for (int c = 0; c < rg::kSilentCycles - 1; ++c) g.observe(obs);
+    expect(!g.verdict().hold, "silent for one cycle short of the limit: not yet");
+    const auto& v = g.observe(obs);
+    expect(v.hold && v.reason == rg::Reason::Silent && v.motor == 7, "silent at the limit: holds, naming motor 8");
+  }
+  {  // power lost and restored under an active arm: the motors come back DISABLED
+    rg::Guard g(8);
+    auto obs = all(true);
+    obs[2].status = 0x0;
+    const auto& v = g.observe(obs);
+    expect(v.hold && v.reason == rg::Reason::Disabled && v.motor == 2, "a motor reporting DISABLED holds the arm");
+  }
+  {  // a fault code (overcurrent, 0xA)
+    rg::Guard g(8);
+    auto obs = all(true);
+    obs[4].status = 0xA;
+    const auto& v = g.observe(obs);
+    expect(v.hold && v.reason == rg::Reason::Fault && v.status == 0xA, "a fault code holds the arm, with the code");
+  }
+  {  // the hold is latched: replies coming back do not release it; only re-activation does
+    rg::Guard g(8);
+    auto obs = all(true);
+    obs[0].status = 0xA;
+    g.observe(obs);
+    expect(g.observe(all(true)).hold, "the hold stays after the motor recovers");
+    g.reset();
+    expect(!g.observe(all(true)).hold, "re-activation clears it");
+  }
+  {  // #210: a held motor whose position's low byte is 0x33 is a status frame, not a register reply
+    const uint8_t held[8] = {0x11, 0x80, 0x33, 0x7f, 0xe7, 0xfd, 0x19, 0x17};  // right J1, 2026-10-12
+    const auto r = rg::parse_reply(1, held, 8);
+    expect(r.alive && r.has_status && r.status == 0x1, "position low byte 0x33 is still a status frame (ENABLED)");
+    const uint8_t reg[8] = {0x01, 0x00, 0x33, 0x0a, 0x00, 0x00, 0x00, 0x00};
+    const auto q = rg::parse_reply(1, reg, 8);
+    expect(q.alive && !q.has_status, "a register reply proves the motor alive, without a status");
+  }
+  std::printf(fails ? "%d FAILED\n" : "all passed\n", fails);
+  return fails ? 1 : 0;
+}
