+}
+
+hardware_interface::return_type OpenArmHW::perform_command_mode_switch(
+    const std::vector<std::string>& start_interfaces,
+    const std::vector<std::string>& stop_interfaces) {
+  auto names = [](const std::vector<std::string>& v, const std::string& joint) {
+    return std::find(v.begin(), v.end(), joint + "/" + hardware_interface::HW_IF_POSITION) != v.end();
+  };
+  if (claimed_.size() != joint_names_.size()) claimed_.assign(joint_names_.size(), false);
+  if (hold_q_.size() != joint_names_.size()) hold_q_ = pos_states_;
+  for (size_t i = 0; i < joint_names_.size(); ++i) {
+    if (names(stop_interfaces, joint_names_[i])) {
+      claimed_[i] = false;
+      hold_q_[i] = pos_states_[i];  // released: hold where it is
+    }
+    if (names(start_interfaces, joint_names_[i])) {
+      claimed_[i] = true;
+      // A controller takes over: its first write may come a cycle later, so the command it inherits
+      // is the measured pose at rest, never a setpoint left from before.
+      pos_commands_[i] = pos_states_[i];
+      vel_commands_[i] = 0.0;
+      tau_commands_[i] = 0.0;
+    }
+  }
   return hardware_interface::return_type::OK;
 }
 
