diff --git a/openarm_hardware/include/openarm_hardware/runtime_guard.hpp b/openarm_hardware/include/openarm_hardware/runtime_guard.hpp
new file mode 100644
index 0000000..a36bc3e
--- /dev/null
+++ b/openarm_hardware/include/openarm_hardware/runtime_guard.hpp
@@ -0,0 +1,126 @@
+// While the arm is active: hold it if a motor goes quiet, drops out of ENABLED, or reports a fault.
+//
+// Upstream checks nothing after activation. A motor that stops answering keeps its last reading in
+// openarm_can, which keeps no timestamp, so its joint looks healthy forever while it is unpowered or
+// cut off. The driver counts each motor's reply frames on a passive socket of its own and feeds the
+// result here, once per read() cycle. The first problem latches: the whole arm then holds the pose it
+// was measured at, ignoring the controller, until the hardware is activated again. Holding, not
+// disabling: a deactivated arm goes limp, and a held one stays where it was.
+//
+// Pure, so it can be tested without a robot (test/test_runtime_guard.cpp).
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace openarm_hardware {
+namespace runtime_guard {
+
+// A motor that misses this many read() cycles in a row is silent. At the 400 Hz controller rate
+// that is 0.1 s; a DAMIAO motor answers every command, so a healthy one never misses more than one.
+constexpr int kSilentCycles = 40;
+
+// DAMIAO status nibble (openarm_can's MotorError): 0 disabled, 1 enabled, 0x8 and up a fault.
+constexpr uint8_t kStatusDisabled = 0x0;
+constexpr uint8_t kFaultThreshold = 0x8;
+
+// One motor, one cycle: whether a reply frame arrived since the last cycle, and the status nibble
+// of its latest reply.
+struct Obs {
+  bool replied;
+  uint8_t status;
+};
+
+// One reply frame on a motor's receive ID. A status frame is [status<<4 | id, pos_hi, pos_lo, ...]; a
+// register reply is [id_lo, id_hi, 0x33|0x55, reg, value x4]. Both prove the motor is alive, but
+// only a status frame carries the status nibble. Byte 2 alone does NOT tell them apart: in a status
+// frame it is the position's low byte (#210, where a held motor read as missing). A status frame
+// matching all three register-reply bytes would be DISABLED at about -710 degrees: out of reach.
+struct Reply {
+  bool alive;
+  bool has_status;
+  uint8_t status;
+};
+
+inline Reply parse_reply(uint8_t motor_id, const uint8_t* d, std::size_t len) {
+  if (len < 8) return {false, false, 0};
+  if (d[0] == motor_id && d[1] == 0 && (d[2] == 0x33 || d[2] == 0x55)) return {true, false, 0};
+  return {true, true, static_cast<uint8_t>(d[0] >> 4)};
+}
+
+enum class Reason { None, Silent, Disabled, Fault };
+
+struct Verdict {
+  bool hold = false;
+  std::size_t motor = 0;  // index in the arm's motor list (joints 0..6, the gripper 7)
+  Reason reason = Reason::None;
+  uint8_t status = 0;
+  std::string text;
+};
+
+class Guard {
+ public:
+  explicit Guard(std::size_t motors, int silent_cycles = kSilentCycles)
+      : missed_(motors, 0), silent_cycles_(silent_cycles) {}
+
+  // At activation: forget the last latch and start counting from now.
+  void reset() {
+    std::fill(missed_.begin(), missed_.end(), 0);
+    verdict_ = Verdict{};
+  }
+
+  // One read() cycle. Returns the latched verdict: once hold is true it stays true until reset().
+  const Verdict& observe(const std::vector<Obs>& obs) {
+    if (verdict_.hold) return verdict_;
+    for (std::size_t i = 0; i < missed_.size() && i < obs.size(); ++i) {
+      if (obs[i].replied) {
+        missed_[i] = 0;
+        if (obs[i].status >= kFaultThreshold) return latch(i, Reason::Fault, obs[i].status);
+        if (obs[i].status == kStatusDisabled) return latch(i, Reason::Disabled, obs[i].status);
+      } else if (++missed_[i] >= silent_cycles_) {
+        return latch(i, Reason::Silent, 0);
+      }
+    }
+    return verdict_;
+  }
+
+  const Verdict& verdict() const { return verdict_; }
+
+ private:
+  const Verdict& latch(std::size_t i, Reason r, uint8_t status) {
+    verdict_.hold = true;
+    verdict_.motor = i;
+    verdict_.reason = r;
+    verdict_.status = status;
+    const std::string who = "motor " + std::to_string(i + 1);
+    switch (r) {
+      case Reason::Silent:
+        verdict_.text = who + " stopped answering (" + std::to_string(missed_[i]) + " cycles)";
+        break;
+      case Reason::Disabled:
+        verdict_.text = who + " reports DISABLED (power lost, or a reset)";
+        break;
+      case Reason::Fault:
+        verdict_.text = who + " reports fault 0x" + hex(status);
+        break;
+      case Reason::None:
+        break;
+    }
+    return verdict_;
+  }
+
+  static std::string hex(uint8_t v) {
+    const char* d = "0123456789ABCDEF";
+    return std::string(1, d[v >> 4 & 0xF]) + d[v & 0xF];
+  }
+
+  std::vector<int> missed_;
+  int silent_cycles_;
+  Verdict verdict_;
+};
+
+}  // namespace runtime_guard
+}  // namespace openarm_hardware
