@@ -295,6 +324,23 @@
 
         return self._state
 
+    def _resolve_dt(self) -> float:
+        """Timestep to use for this tick's velocity clamp.
+
+        Fixed (twist_dt) by default. When use_measured_dt is set, uses
+        actual wall-clock time since the previous step() call instead,
+        clamped to max_measured_dt -- see TeleopConfig.use_measured_dt.
+        """
+        if not self._config.use_measured_dt:
+            return self._config.twist_dt
+
+        now = time.monotonic()
+        last = self._last_step_time
+        self._last_step_time = now
+        if last is None:
+            return self._config.twist_dt
+        return min(max(now - last, 1e-6), self._config.max_measured_dt)
+
     # -- Lifecycle ------------------------------------------------------------
 
