#!/usr/bin/env python3
"""Direct, stack-independent check of the OpenArm motors over CAN.

    openarm-motors [status]              one line per motor, both arms
    openarm-motors summary               counts only: "enabled=N disabled=N faults=N missing=N"
    openarm-motors disable               send DISABLE to every motor, then re-read

Talks to the DAMIAO motors directly on arm_left / arm_right (names from
/etc/udev/rules.d/70-openarm-can.rules), so it works whether or not the ROS stack is up.
It can only send two frames: the read-only "refresh" query (0x7FF [id,0,0xCC,...]) and
DISABLE ([0xFF]*7 + 0xFD). It never enables, moves, writes parameters, or sets zero.
Protocol from enactic/openarm_can: send ids 1-8 (7 joints + gripper), replies on 0x10+id,
CAN-FD with bit-rate switch, 8-byte payload.
"""
import os
import re
import socket
import struct
import sys
import time

IFACES = ("arm_left", "arm_right")
CANFD_BRS = 0x01
FRAME = struct.Struct("=IBBBB64s")          # struct canfd_frame
STATUS = {0x0: "DISABLED", 0x1: "ENABLED", 0x8: "OVERVOLTAGE", 0x9: "UNDERVOLTAGE",
          0xA: "OVERCURRENT", 0xB: "MOS_OVERHEAT", 0xC: "COIL_OVERHEAT",
          0xD: "COMMUNICATION_LOST", 0xE: "OVERLOAD"}
P_MAX = 12.5
ARMS_CONF = os.environ.get("OPENARM_ARMS_CONF", "/etc/opendubs/openarm-arms.conf")


def left_hand():
    """False when this robot runs its left arm without the gripper (OPENARM_LEFT_HAND=false in
    ARMS_CONF, the file openarm-up reads). Then arm_left's id 8 is left out: not queried, not
    listed, not counted, so a healthy robot reads missing=0."""
    v = os.environ.get("OPENARM_LEFT_HAND")
    try:
        with open(ARMS_CONF) as fh:
            for line in fh:
                m = re.match(r"\s*OPENARM_LEFT_HAND\s*=\s*\"?(\w+)", line)
                if m:
                    v = m.group(1)
    except OSError:
        pass
    return (v or "true").lower() != "false"


def ids_for(iface):
    return range(1, 8) if iface == "arm_left" and not left_hand() else range(1, 9)


def frame(can_id, data):
    return FRAME.pack(can_id, 8, CANFD_BRS, 0, 0, bytes(data).ljust(64, b"\0"))


def refresh(mid):
    return frame(0x7FF, [mid, 0, 0xCC, 0, 0, 0, 0, 0])


def disable(mid):
    return frame(mid, [0xFF] * 7 + [0xFD])


def open_bus(iface):
    s = socket.socket(socket.AF_CAN, socket.SOCK_RAW, socket.CAN_RAW)
    s.setsockopt(socket.SOL_CAN_RAW, socket.CAN_RAW_FD_FRAMES, 1)
    s.bind((iface,))
    s.settimeout(0.02)
    return s


def drain(s, limit=0.05):
    """Discard queued frames. Time-bounded: with the ROS stack up, the bus never goes quiet."""
    end = time.monotonic() + limit
    while time.monotonic() < end:
        try:
            s.recv(FRAME.size)
        except (socket.timeout, BlockingIOError):
            return


def is_param_reply(mid, d):
    """A register read/write reply, [id_lo, id_hi, 0x33|0x55, reg, value x4], not a status frame.

    Byte 2 alone does not tell them apart: in a status frame it is the low byte of the position,
    so 0x33 or 0x55 turns up at about 1 pose in 128. Testing only byte 2 reported a held motor
    as `no reply` for as long as it held still (opendubs2, right J1 at +1.13 deg, 2026-10-12).
    A status frame matching all three bytes would be DISABLED at about -710 deg: out of reach.
    """
    return d[0] == mid and d[1] == 0 and d[2] in (0x33, 0x55)


def parse(mid, can_id, n, d):
    """Motor state (status name, position deg, MOS C, rotor C) if this frame is mid's status."""
    if (can_id & 0x7FF) != 0x10 + mid or n < 8 or is_param_reply(mid, d):
        return None
    q = ((d[1] << 8) | d[2]) * (2 * P_MAX) / 65535.0 - P_MAX
    st = d[0] >> 4
    return STATUS.get(st, f"UNKNOWN_0x{st:X}"), q * 57.29578, d[6], d[7]


def read(s, mid):
    """Motor state (status name, position deg, MOS C, rotor C), or None if it didn't answer."""
    s.send(refresh(mid))
    end = time.monotonic() + 0.1
    while time.monotonic() < end:
        try:
            raw = s.recv(FRAME.size)
        except socket.timeout:
            continue
        can_id, n, _f, _a, _b, data = FRAME.unpack(raw.ljust(FRAME.size, b"\0"))
        r = parse(mid, can_id, n, data[:8])
        if r is not None:
            return r
    return None


def rows_for():
    out = []
    for iface in IFACES:
        try:
            s = open_bus(iface)
        except OSError as e:
            out += [(iface, mid, None, f"no bus: {e.strerror}") for mid in ids_for(iface)]
            continue
        drain(s)
        for mid in ids_for(iface):
            out.append((iface, mid, read(s, mid), None))
        s.close()
    return out


def counts(rows):
    c = {"enabled": 0, "disabled": 0, "faults": 0, "missing": 0}
    for _i, _m, r, _e in rows:
        if r is None:
            c["missing"] += 1
        elif r[0] == "ENABLED":
            c["enabled"] += 1
        elif r[0] == "DISABLED":
            c["disabled"] += 1
        else:
            c["faults"] += 1
    return c


def fmt_counts(c):
    return " ".join(f"{k}={v}" for k, v in c.items())


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "disable":
        for iface in IFACES:
            try:
                s = open_bus(iface)
            except OSError as e:
                print(f"{iface}: cannot open ({e.strerror})")
                continue
            for _ in range(3):
                for mid in range(1, 9):
                    s.send(disable(mid))
                time.sleep(0.01)
            time.sleep(0.05)
            s.close()
        c = counts(rows_for())
        print(fmt_counts(c))
        sys.exit(0 if c["enabled"] == 0 else 1)
    rows = rows_for()
    if cmd == "summary":
        print(fmt_counts(counts(rows)))
        return
    if cmd != "status":
        sys.exit(__doc__)
    last = None
    for iface, mid, r, err in rows:
        if iface != last:
            print(f"{iface}")
            last = iface
        name = "gripper" if mid == 8 else f"joint {mid}"
        if r is None:
            print(f"  id {mid} ({name:7s})  {err or 'no reply'}")
        else:
            st, deg, tm, tr = r
            print(f"  id {mid} ({name:7s})  {st:18s}  pos {deg:+8.2f} deg  MOS {tm:3d}C  rotor {tr:3d}C")
    print(fmt_counts(counts(rows)))


if __name__ == "__main__":
    main()
