# The page's local agent on 127.0.0.1:8095 (device.json, the heartbeat) and the browser's watchdog.
[Unit]
Description=OpenDubs stage: the page's local agent and the browser's watchdog
After=stage-kiosk.service stage-media.service
Wants=stage-media.service

[Service]
ExecStart=/usr/local/lib/stage/stage-agent
Environment=STAGE_RUN=/run/stage
# The sound's own runtime files (the test tone; the settings when there is no media stick). Its own
# directory: the kiosk's /run/stage is removed whenever the browser restarts.
RuntimeDirectory=stage-sound
RuntimeDirectoryMode=0755
Environment=STAGE_SOUND_RUN=/run/stage-sound
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
