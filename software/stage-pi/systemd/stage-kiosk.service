# The stage box's browser: cage (one app, full screen, no desktop) running Chromium on the robot's
# /stage/ page, as the `stage` user in its own login session on tty1 (the same as an autologin).
[Unit]
Description=OpenDubs stage: a full-screen browser on the robot's /stage/ page
After=systemd-user-sessions.service network-online.target stage-mode.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=stage
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=stage
RuntimeDirectoryMode=0750
ExecStart=/usr/local/lib/stage/stage-kiosk
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
