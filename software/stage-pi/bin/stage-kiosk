#!/bin/bash
# The stage box's one job: a full-screen browser on the robot's /stage/ page. Run by stage-kiosk.service
# as the `stage` user; systemd restarts it whenever it ends, and a display change restarts it (the udev
# rule) so the new screen's mode is taken.
set -u
LIB=/usr/local/lib/stage
RUN=${RUNTIME_DIRECTORY:-/run/stage}
rm -f "$RUN/page"                       # the agent's watchdog waits until the page is handed over again
url=$("$LIB/stage-conf" ROBOT_URL http://opendubs2.local:8080/stage/)
fallback=$("$LIB/stage-conf" ROBOT_FALLBACK http://10.42.2.10:8080/stage/)
"$LIB/stage-audio" "$("$LIB/stage-conf" AUDIO auto)"

sleep 1                                # a display change arrives as a burst of events: let it settle

# Wait for the robot rather than open an error page: whichever address answers first, retrying forever.
# (A page that failed to load cannot retry by itself; the stage page reconnects once it is up.)
page=""
until [ -n "$page" ]; do
    for u in "$url" "$fallback"; do
        if curl -fsS -o /dev/null --max-time 3 "$u"; then page=$u; break; fi
    done
    [ -n "$page" ] || sleep 2
done
echo "$page" > "$RUN/page"

# The show's video is preloaded whole into memory when a show is armed, and cached across runs (#479).
# On this box EVERYTHING written lands in RAM (the root is read-only, its writes in a RAM overlay), so
# the cache is capped by the board's memory and passed to the page: 800 MB from 4 GB up, 300 MB from
# 2 GB, else 150 MB. CACHE_MB in stage.conf overrides it.
mem_mb=$(awk '/^MemTotal:/ {print int($2 / 1024)}' /proc/meminfo)
cache=$("$LIB/stage-conf" CACHE_MB "")
if ! printf '%s' "$cache" | grep -Eq '^[0-9]+$'; then
    if [ "$mem_mb" -ge 3500 ]; then cache=800; elif [ "$mem_mb" -ge 1800 ]; then cache=300; else cache=150; fi
fi
case $page in *\?*) open_url="$page&cache_mb=$cache" ;; *) open_url="$page?cache_mb=$cache" ;; esac

# A screen, or none. With no screen the box still plays the show's sound: the compositor then runs on a
# virtual output so the page keeps running as if it were shown.
export WLR_LIBINPUT_NO_DEVICES=1
if grep -qsx connected /sys/class/drm/card*-HDMI-A-*/status; then
    export WLR_BACKENDS=drm
    echo screen > "$RUN/screen"
else
    export WLR_BACKENDS=headless WLR_RENDERER=pixman
    echo none > "$RUN/screen"
fi

browser=$(command -v chromium || command -v chromium-browser)
exec cage -d -- "$browser" --kiosk "$open_url" \
    --ozone-platform=wayland \
    --user-data-dir="$HOME/.stage-chromium" \
    --autoplay-policy=no-user-gesture-required \
    --noerrdialogs --disable-infobars --disable-session-crashed-bubble --no-first-run \
    --hide-scrollbars --overscroll-history-navigation=0 --password-store=basic \
    --disable-features=Translate,MediaRouter --check-for-update-interval=31536000
