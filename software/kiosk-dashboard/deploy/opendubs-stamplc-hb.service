[Unit]
Description=OpenDubs StamPLC Ethernet heartbeat (feeds the firmware link watchdog)
# network.target, not network-online.target: it needs only a LAN address, and on a network with no
# internet "online" can wait or never come. A start before the address exists fails and restarts.
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/opendubs/kiosk-dashboard/stamplc_hb.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
