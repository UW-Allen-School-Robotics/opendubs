[Unit]
Description=OpenDubs Kiosk Dashboard backend (FastAPI)
# network.target, not network-online.target: it needs only a LAN address, and on a network with no
# internet "online" can wait or never come. A start before the address exists fails and restarts.
After=network.target

[Service]
Type=simple
User=kiosk
SupplementaryGroups=dialout
WorkingDirectory=/opt/opendubs/kiosk-dashboard/backend
# HTTP on 8080 (unchanged: on-robot tools call it) and, once deploy/make-robot-ca.sh has made this
# robot's certificate, HTTPS on 8443 for the tablet — one process, because it owns the serial port.
ExecStart=/opt/opendubs/venv/bin/python serve.py
Restart=always
RestartSec=2
# A backstop only: serve.py itself closes open connections after 2 s on a stop. Without that, every
# stop ran out the default 90 s and was killed (2026-10-19).
TimeoutStopSec=15
# tegrastats/nvpmodel read from /sys. MAVLink now comes from MAVROS (which owns
# the Pixhawk serial) over a local UDP forward — NOT the raw /dev/ttyACM* port.
# (dialout kept as a harmless fallback in case of reverting to direct serial.)
Environment=OPENDUBS_MAVLINK_DEV=udpin:127.0.0.1:14550
# Per-robot settings, kept on the robot and never in the repo — OPENDUBS_ROBOT_NAME="OpenDubs 2" is the
# name every dashboard shows. Optional ("-"): without it the name is the Thor's hostname.
EnvironmentFile=-/etc/opendubs/robot.env

[Install]
WantedBy=multi-user.target
