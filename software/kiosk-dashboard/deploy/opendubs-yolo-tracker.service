[Unit]
Description=OpenDubs YOLO Face Tracker (Thor -> Tab5)
After=network.target

[Service]
Type=simple
User=kiosk
WorkingDirectory=/opt/opendubs/kiosk-dashboard/backend
ExecStart=/opt/opendubs/venv/bin/python /opt/opendubs/kiosk-dashboard/backend/yolo_tracker.py --source http://opendubs-tab5.local:80/stream
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
