[Unit]
Description=OpenDubs show runner — the routine palette behind the Shows page (drives the arms and the twins)
# network.target, not network-online: the runner needs only this machine (the dashboard on localhost)
# and the robot's own LAN (the arms over DDS), never the internet, and must start with no uplink
# (offline readiness, 2026-10-17)
After=network.target opendubs-dash.service
Wants=opendubs-dash.service

[Service]
Type=simple
User=kiosk
WorkingDirectory=/opt/opendubs/choreo
# The arms' joint limits are the arm stack's own file, read in place (choreography plan 4.4c). It
# lives in a checkout this account cannot otherwise reach, so provision-runner.sh adds a robot-local
# drop-in that binds just that one directory here, read-only, for this service alone. Without it the
# file is absent and the runner refuses every routine, saying why.
Environment=OPENDUBS_ARM_LIMITS=/etc/opendubs/arm-limits/joint_limits.yaml
# This robot's own settings, as opendubs-dash and the tracker read them — above all where the head is
# (OPENDUBS_HEAD_FACE_HOST / OPENDUBS_HEAD_NECK_HOST, face_bridge.head_face_host()): without this the
# runner's live face fell back to opendubs-tab5.local whatever robot.env said. "-": absent is fine.
EnvironmentFile=-/etc/opendubs/robot.env
# Localhost only (the runner binds 127.0.0.1); the dashboard forwards the Shows page's calls. Robot
# state is the dashboard's read-only view of it; nothing here commands the robot.
# Show audio (plan 4.2) plays on the dashboard's show-audio device — the tablet by default.
# LIVE arm output (plan 5.6): `--arms ros` lets a run the operator marks LIVE on the Shows page move
# the real arms, through the arm controllers' FollowJointTrajectory actions. So the runner runs under
# ROS (the system Python, ROS sourced) with the same DDS settings as the teleop service, which talk to
# the `openarm` container. Without ROS it still serves, twin-only, and says so.
# The LIFT and the state LIGHT (show_outputs.py), each armed here and acting on live runs only:
# the lift through the dashboard's /api/mast (the StamPLC's 250 ms intent, its pinch guard; an
# operator's own lift command wins for the rest of the run), the light as a layer the dashboard puts
# over the state colour (show_light.py; a reserved state always wins). Drop either flag to disarm it.
# PROJECTOR VIDEO (video_out.py, notes/design/choreo-video.md): `--video cast,stage`. `cast` casts a
# show's VIDEO cues to the projector's built-in Chromecast, serving the files on OPENDUBS_VIDEO_PORT
# (8094; 8093 is the voice service), bound to the robot-LAN interface avahi uses (or OPENDUBS_VIDEO_BIND
# in robot.env). `stage` hands the show's timing to the stage page (/stage/, choreo-stage.md), which
# plays the video itself and draws the live skeletons over it. Add `hdmi` once opendubs-video-hdmi (mpv
# on the HDMI out) is provisioned. A projector that isn't there never stops a show unless it requires it.
# THE BASE (base_output.py, notes/design/choreo-dance-live.md): `--base ros` sends a live run's DANCE moves
# to the Thor's base tracker (/dance/*), which follows them on /odom and stops for people (the LIDARs).
# No tracker running: shows run without their dance steps, saying so. CH5 AUTO and the deadman still gate it.
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# The robot's FastDDS profile (provision-ros.sh): UDP on 127.0.0.1 only, no shared memory, no
# multicast, so the runner's discovery stays off the robot's Wi-Fi. It still reaches the arm
# container, whose profile differs. Not ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST: in Jazzy that adds
# shared memory, which doesn't cross from this user to the container.
Environment=FASTDDS_DEFAULT_PROFILES_FILE=/etc/opendubs/fastdds-robot.xml
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/etc/opendubs/fastdds-robot.xml
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && exec /usr/bin/python3 runner.py palette --robot dashboard --audio dashboard --arms ros --face auto --gaze auto --earcons off --lift dashboard --light dashboard --video cast,stage --base ros --port 8092 --log /var/log/opendubs-runner/runner.jsonl'
LogsDirectory=opendubs-runner
# The projector's per-robot settings (projector.json: the audio and video offsets set by ear, how it
# takes music) and the cast cache live here, on the robot, never in the repo (choreo-audio.md)
StateDirectory=opendubs-runner
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
