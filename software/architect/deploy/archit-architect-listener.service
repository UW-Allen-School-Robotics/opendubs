# A TEST UNIT for the Halloween ARCHITECT demo (software/architect/README.md): the Jabra listener: "trick or treat" asks the coordinator, then plays the candy show.
# Not part of the robot's stack: no deploy or provisioner installs or touches it. Filled in and
# installed by `software/architect/tools/dev.sh install`, removed by `dev.sh uninstall`. The
# @...@ fields are filled in then; this file in the repo is the template.
[Unit]
Description=ARCHITECT test: the Jabra listener: "trick or treat" asks the coordinator, then plays the candy show (container archit-architect-listener)
After=docker.service sound.target archit-architect-day.service
Requires=docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Environment=REPO=@REPO@ DATA=@DATA@ FOREGROUND=1
Environment=SHOW=@SHOW@ DAY=1 PROGRAM=@PROGRAM@ SHOW_AUDIO=1
ExecStartPre=-/usr/bin/sudo -n /usr/bin/docker rm -f archit-architect-listener
ExecStart=@REPO@/software/architect/tools/dev.sh listen
ExecStop=/usr/bin/sudo -n /usr/bin/docker stop -t 5 archit-architect-listener
# The Jabra unplugged, or the dashboard not up yet (the show palette is checked at start): try again.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
