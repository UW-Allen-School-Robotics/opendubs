<mujoco model="opendubs">
  <!-- ============================ READ THIS FIRST ==================================
       THE GEOMETRY IS REAL. THE DYNAMICS ARE NOT.

       Every length, axis and pivot here traces to CAD or to a measurement, and where one
       does not it says so. None of that is true of the masses, inertias, stiffnesses,
       damping or speeds: the chassis mass is a guess, the head's is mesh volume at the
       density of water, the arm masses come from someone else's model, and the lift's
       speed and stiffness were chosen to look right rather than measured.

       So this model can answer: does this pose collide, can the arm reach there, how much
       clearance is there, does the sequence read. It CANNOT answer anything about force,
       torque, sag, tipping, motor sizing, how long a move takes, or what the robot does
       when something pushes it. Numbers of that kind out of this model are decoration.
       ===============================================================================

       OpenDubs: chassis, wheels, and the Z-axis, in the CAD model's own frame.

       THE CAD ORIGIN IS THE DATUM. Meshes are exported at it, and every offset below is the
       real spatial relationship rather than a convenience frame invented for the simulator.
       The floor is at z = -94 mm: the wheels are 140 mm across with centres at z = -24, so
       their contact patch lands there. That is derived from the meshes, not assumed.

       The arms are NOT modelled here. openarm_assets ships a complete bimanual model including
       the stock V1 extrusion frame they stand on; it gets attached to the lift platform below.
       Its own root frame has the origin at the BOTTOM of the extrusion, centred in Y, spanning
       x -155..+95 — so the origin sits 30 mm ahead of that body's geometric centre.

       Units: the meshes are millimetres, MJCF is metres, hence scale 0.001 throughout. -->

  <compiler angle="radian" meshdir="meshes/"/>
  <!-- implicitfast, not the default explicit Euler. Wheel and roller inertias are small
       against the damping and the velocity actuators driving them: a 0.77 kg wheel at kv 1 has
       a time constant well under the timestep, which explicit integration turns into a
       divergence. Driving in reverse used to spin the rear rollers to 16000 rad/s and trip
       MuJoCo's own reset. Implicit integration of those damping terms costs almost nothing. -->
  <option gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <!-- Big enough to render a readable preview offscreen; MuJoCo's default is 640x480. -->
    <global offwidth="1640" offheight="1120"/>
  </visual>

  <default>
    <default class="visual">
      <geom group="2" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="3"/>
    </default>
    <default class="roller">
      <!-- Rollers collide with the GROUND AND NOTHING ELSE. contype 2 / conaffinity 0 against
           a ground plane whose conaffinity includes bit 2: roller-vs-ground matches, and
           roller-vs-roller, roller-vs-chassis and roller-vs-arm all fail both tests. Without
           this the rollers of one wheel fight each other (they overlap, as real ones do) and
           every wheel sits inside the chassis bounding box, which is a crude box that
           swallows them. -->
      <geom type="capsule" size="0.010" contype="2" conaffinity="0" group="3"
            rgba="0.10 0.10 0.11 1"/>
    </default>
  </default>

  <asset>
    <mesh name="wheel_fl" file="FL-wheel.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="wheel_fr" file="FR-wheel.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="wheel_rl" file="RL-wheel.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="wheel_rr" file="RR-wheel.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="zaxis"    file="z-axis-down.stl" scale="0.001 0.001 0.001"/>
    <!-- The head, as two groups exported in the HEAD ASSEMBLY'S OWN FRAME (dimensions.yaml
         head.export): the neck, which turns with pan, and the face (the tablet and its mounts),
         which tilts. See the head bodies below for how they are placed. -->
    <mesh name="head_neck_pan"  file="head_neck_pan.stl"  scale="0.001 0.001 0.001"/>
    <mesh name="head_face_tilt" file="head_face_tilt.stl" scale="0.001 0.001 0.001"/>
    <!-- The Femto Bolt module, the FITTED mount: it tilts the camera 30 deg down, and its one mesh
         carries the mount and the camera's 115 x 65 x 40 mm envelope (not Orbbec's CAD). It was
         exported 380 mm to the robot's right and 8 mm low (dimensions.yaml head.export.registered);
         the geom's pos below seats it. -->
    <mesh name="femto_mount_tilt30" file="femto_mount_tilt30.stl" scale="0.001 0.001 0.001"/>
    <!-- The STRAIGHT mount (camera square to the face), in the head's export frame: its mount, and
         the camera's envelope. Unused here; variants.py swaps it in (dimensions.yaml
         femto_mount.variants). -->
    <mesh name="femto_mount"    file="femto_mount.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="femto_bolt"     file="femto_bolt.stl"     scale="0.001 0.001 0.001"/>
    <!-- The chest cover, with the neck's M5Dial on its back, in the head's export frame. -->
    <mesh name="chest_cover"    file="chest_cover.stl"    scale="0.001 0.001 0.001"/>
    <material name="frame" rgba="0.25 0.26 0.28 1"/>
    <material name="rubber" rgba="0.12 0.12 0.13 1"/>
    <material name="plate" rgba="0.55 0.57 0.60 1"/>
    <material name="stage" rgba="0.72 0.58 0.40 1"/>
  </asset>

  <worldbody>
    <light pos="1 -1 2.5" dir="-0.3 0.3 -1" diffuse="0.9 0.9 0.9"/>
    <!-- The floor, placed from the wheels rather than assumed: -94 mm in CAD coordinates. -->
    <geom name="ground" type="plane" pos="0 0 -0.094" size="4 4 0.05" rgba="0.18 0.19 0.2 1"
          conaffinity="3"/>

    <body name="chassis" pos="0 0 0">
      <!-- The base is FREE: it stands on its wheels and goes where they push it. It used to be
           welded to the world, back when the wheels were scenery. -->
      <freejoint name="base"/>
      <!-- ESTIMATED, not weighed — and the model will not run without it. Taking mass from the
           chassis mesh would give 169 kg, because that mesh is a bounding box and MuJoCo fills
           it with water at its default density. 40 kg with the centre of mass low (batteries
           and motors sit near the floor, not at the box's centroid) is a guess that behaves
           sanely. Weigh the robot before believing anything dynamic. -->
      <inertial pos="0.29 0 0.02" mass="40" diaginertia="1.9 1.9 2.8"/>
      <!-- A BOX, not a mesh. chassis.stl was a bounding shape whose extrude left an 8 mm step
           at two diagonally opposite corners — not real geometry, and MuJoCo filled it back in
           anyway because mesh collision uses the convex hull. Stating the same volume as a
           primitive is exact, has no corner artefact, and removes a file that only ever
           described a box: x -32..612, y +/-324.5, z -48..356 mm.
           Replace with a mesh when the chassis is drawn for real. -->
      <geom class="visual"    type="box" pos="0.290 0 0.154" size="0.322 0.3245 0.202"
            material="frame"/>
      <geom class="collision" type="box" pos="0.290 0 0.154" size="0.322 0.3245 0.202"
            name="chassis_collision"/>

      <!-- THE BUCKET STAGE, in front of the robot over the front lidar (dimensions.yaml
           bucket_stage, which says how it was registered on the lift plate). A plain box in the
           CAD it came from, so a box here: x 597..829, y -190..234, z 296.6..348.1 mm. Its top is
           flush with the lift plate's underside with the lift down; its underside is 55 mm above
           the front lidar's scan plane. Fixed to the chassis (TODO_CONFIRM). -->
      <geom class="visual"    type="box" pos="0.713 0.022 0.322305" size="0.116 0.212 0.02575"
            material="stage" name="bucket_stage_visual"/>
      <geom class="collision" type="box" pos="0.713 0.022 0.322305" size="0.116 0.212 0.02575"
            name="bucket_stage_collision"/>
      <!-- The centre of the stage's top face, axes as the chassis': where a bucket's base sits. -->
      <site name="bucket_stage_top" pos="0.713 0.022 0.348055" size="0.008" rgba="0.95 0.75 0.2 1"/>


      <!-- THE WHEELS. Mecanum, so they are not cylinders with sideways grip: each is a hub that
           turns on its axle carrying a ring of free-spinning rollers skewed 45 degrees. That
           skew is the whole mechanism — a driven hub pushes along its rollers' perpendicular,
           and the four diagonal push directions add up to travel in any direction.

           MODELLED, NOT SUPPLIED. The four wheel meshes are byte-identical 412-triangle
           cylinders with no roller detail and no handedness, so the rollers here are authored:
           16 capsules of radius 10 mm on a 60 mm hub, giving the measured 140 mm diameter and
           50 mm width. The count and the capsule shape are a simplification (real rollers are
           barrels that taper at the ends), which is what this model wants for collision
           geometry. What is NOT invented is the handedness: FL and RR skew one way, FR and RL
           the other, taken from the firmware mixer in rc_serial_probe, where FL and RR share a
           strafe sign and FR and RL share the opposite one.

           Handedness was then CHECKED, not assumed — see scene.py --drive, which runs the
           firmware's own mixer and reports where the robot actually goes. -->
      <body name="wheel_fl" pos="0.528 0.2945 -0.024">
        <joint name="wheel_fl" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom class="visual" type="mesh" mesh="wheel_fl" material="rubber"
              pos="-0.528 -0.2945 0.024"/>
        <replicate count="16" euler="0 22.5 0">
          <body pos="0.060 0 0">
            <joint type="hinge" axis="0 0.70711 -0.70711" damping="0.00002" armature="5e-05"/>
            <geom class="roller" fromto="0 -0.01499 0.01499 0 0.01499 -0.01499"/>
          </body>
        </replicate>
      </body>

      <body name="wheel_fr" pos="0.528 -0.2945 -0.024">
        <joint name="wheel_fr" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom class="visual" type="mesh" mesh="wheel_fr" material="rubber"
              pos="-0.528 0.2945 0.024"/>
        <replicate count="16" euler="0 22.5 0">
          <body pos="0.060 0 0">
            <joint type="hinge" axis="0 0.70711 0.70711" damping="0.00002" armature="5e-05"/>
            <geom class="roller" fromto="0 -0.01499 -0.01499 0 0.01499 0.01499"/>
          </body>
        </replicate>
      </body>

      <body name="wheel_rl" pos="0.12 0.2945 -0.024">
        <joint name="wheel_rl" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom class="visual" type="mesh" mesh="wheel_rl" material="rubber"
              pos="-0.12 -0.2945 0.024"/>
        <replicate count="16" euler="0 22.5 0">
          <body pos="0.060 0 0">
            <joint type="hinge" axis="0 0.70711 0.70711" damping="0.00002" armature="5e-05"/>
            <geom class="roller" fromto="0 -0.01499 -0.01499 0 0.01499 0.01499"/>
          </body>
        </replicate>
      </body>

      <body name="wheel_rr" pos="0.12 -0.2945 -0.024">
        <joint name="wheel_rr" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom class="visual" type="mesh" mesh="wheel_rr" material="rubber"
              pos="-0.12 0.2945 0.024"/>
        <replicate count="16" euler="0 22.5 0">
          <body pos="0.060 0 0">
            <joint type="hinge" axis="0 0.70711 -0.70711" damping="0.00002" armature="5e-05"/>
            <geom class="roller" fromto="0 -0.01499 0.01499 0 0.01499 -0.01499"/>
          </body>
        </replicate>
      </body>

      <!-- The Z-axis. A scissor lift in reality; a prismatic joint here, because choreography
           only cares where the platform ends up. Stroke 275.1 mm = 10.83 in (manufacturer).
           Zero is the lowered state the mesh was exported in. -->
      <body name="lift_platform" pos="0 0 0">
        <!-- STIFF. A scissor lift driven through a screw does not bounce, and the model had it
             springing at about 2 Hz: kp 4000 against the ~25 kg it carries is a soft spring,
             and damping 20 against a critical 630 is a damping ratio of 0.03. Raised to a
             stiffness that is rigid at the scale anything here cares about, and damped at the
             joint as well so the lift settles dead rather than ringing. The real mechanism is
             also not backdrivable, which this approximates by simply being hard to move. -->
        <joint name="zaxis" type="slide" axis="0 0 1" range="0 0.2751" damping="40000"/>
        <geom class="visual"    type="mesh" mesh="zaxis" material="plate"/>
        <geom class="collision" type="mesh" mesh="zaxis" name="lift_collision"/>
        <inertial pos="0.348 0 0.3571" mass="8" diaginertia="0.2 0.2 0.3"/>

        <!-- Where the arms stand: openarm_body_link0's ORIGIN, in CAD coordinates.
             x 0.423 as measured in CAD. (An earlier guess of 0.453 came from reading "423 to
             the centre of the root body" against that body's mesh, which is offset 30 mm from
             its own origin; it put the frame's front face exactly flush with the plate edge,
             which looked like confirmation and was coincidence. Checked on the render: 30 mm
             too far forward.)
             z 0.3575 is the plate's top face in the lowered state.
             ATTACH POINT — the bimanual model goes here:
               <include file="openarm_bimanual_decorated.xml"/> with its root at this site. -->
        <site name="arm_frame_mount" pos="0.423 0 0.3575" size="0.012" rgba="0.9 0.5 0.1 1"/>

        <!-- THE CHEST COVER, fixed to the top of the arm extrusion, with the neck's M5Dial on its
             back (the -x side). It replaces the OpenArm frame's stock cover (sim/scene.py hides
             that one) and sits where it did: x -82.2..65.6, y +/-47, z 613..785 mm in the head's
             export frame, so it is placed by the head's translation (dimensions.yaml head.export).
             Its top is 8 mm below the neck.

             Collision is a BOX, not the mesh. MuJoCo collides a mesh as its convex hull, and the
             hull's sides at y +/-47 wrap the two shoulder bases (the arms' fixed link0, from
             y +/-31 outward): every sweep would report that as a contact that never ends. The box
             stops at y +/-29.5, between the shoulder bases. The 17 mm band outside it on each
             side is occupied by the shoulder bases themselves. Large elsewhere: x, z about 2 mm outward. -->
        <geom class="visual" type="mesh" mesh="chest_cover" material="frame" pos="0.423 0 0.356875"
              name="chest_cover_visual"/>
        <geom class="collision" type="box" pos="0.4147 0 1.055875" size="0.07589 0.0295 0.088"
              name="chest_cover_collision"/>

        <!-- THE HEAD: a Samsung Galaxy Tab A11 on a pan/tilt neck. Rides with the extrusion, so
             it hangs off the lift platform.
             TILT AXIS at CAD (423, 0, 1245.575), measured — 115.1 mm above the top of the arm
             extrusion, on the same x as the arm frame. The PAN axis is the vertical through it,
             so the two meet, and this body's origin is that point.

             The two meshes are exported in the head assembly's own frame, where the pan/tilt
             point is (0, 0, 888.7) mm and the tablet faces +x. That frame is placed on the robot
             by a PURE TRANSLATION, (+423, 0, +356.875) mm, with no rotation (dimensions.yaml
             head.export). In this body's frame that is one offset, pos (0, 0, -0.8887), the same
             for both meshes, and every vertex lands where CAD put it.

             The neck excludes the two goBILDA servos and their bearing blocks, which the export
             does not carry (dimensions.yaml head.not_modelled). -->
        <body name="head_pan" pos="0.423 0 1.245575">
          <!-- PAN is limited by nothing but the servo's own travel: the goBILDA 2000-series
               dual-mode servo turns 300 deg, and the horn was set at the middle of that, so
               +/-150 deg. No mechanical stop in the bracket and no slip ring on this build.
               That is deliberately wide — whether the head can actually sweep that far without
               meeting the arms or the extrusion is a question for the model to answer, not one
               to pre-empt by narrowing the joint. -->
          <joint name="head_pan" type="hinge" axis="0 0 1" damping="1"
                 range="-2.6180 2.6180"/>
          <!-- Nominal, not weighed: MuJoCo refuses a moving body without mass. -->
          <inertial pos="0 0 0" mass="0.3" diaginertia="0.001 0.001 0.001"/>
          <geom class="visual" type="mesh" mesh="head_neck_pan" material="frame" pos="0 0 -0.8887"/>
          <!-- What the arms must not hit on the neck: one coarse box from the mesh's extents,
               relative to the pan/tilt point: x -46..26, y -47.5..47.5, z -95.7..24.3 mm, 2 mm
               outward. Large is the safe error. -->
          <geom class="collision" type="box" pos="-0.010 0 -0.036" size="0.038 0.0495 0.062"
                name="neck_collision"/>
          <body name="head_tilt">
            <!-- TILT TRAVEL IS ASYMMETRIC. Characterised on this neck's goBILDA tilt servo
                 (firmware/tab5_pantilt/README.md) by creeping it and watching current,
                 soft-stopping at 0.20 A so it never stalled:
                   920 us  full up      1545 us  HORIZONTAL      1650 us  full down
                   hard stop measured at 1680 us
                 The goBILDA 2000-series dual-mode servo travels 300 deg out of the box (their
                 spec), so 500-2500 us is 6.667 us/deg, giving 93.8 deg UP and 15.8 deg
                 DOWN, with the hard stop a further 4.5 deg below. (That README converts at
                 7.14 us/deg from an assumed 280 deg; its own note that 920 us is "slightly past
                 vertical" agrees with 6.667, not 7.14.)
                 The servo and the axes did not change when the face parts did, but the new face
                 may meet its stops elsewhere: this range is the servo's, and the robot's
                 operating limits are the neck controller's (the M5Dial's per-robot tilt limits).
                 DERIVED, not measured with a protractor.

                 Positive here is DOWN: the joint turns about +y, so +x swings toward -z.
                 Confirmed on the model: +30 deg drops the screen centre from z 1230.4 to
                 1191.1 mm. -->
            <joint name="head_tilt" type="hinge" axis="0 1 0" damping="1"
                   range="-1.6362 0.2749"/>
            <geom class="visual" type="mesh" mesh="head_face_tilt" material="plate" pos="0 0 -0.8887"/>

            <!-- What the arms must not hit on the face: one coarse box from the mesh's extents
                 (the tablet, its holder and the arms that carry it), relative to the tilt axis:
                 x -15.9..85.8, y -110.5..110.5, z -82.0..52.0 mm, about 2 mm outward. The arms
                 need to know the head is there, not its fillets, and large is the safe error. -->
            <geom class="collision" type="box" pos="0.035 0 -0.015" size="0.053 0.1125 0.069"
                  name="head_collision"/>

            <!-- The screen: the centre of the tablet's front face, x out of the glass. From the
                 mesh: the tablet's front face is the 211.0 x 124.7 mm plane at x = 82.8 mm, its
                 display area 189.0 x 113.6 mm, both centred at y -0.35, z -15.15 mm from the tilt
                 axis. The face page belongs here. -->
            <site name="head_screen" pos="0.0828 -0.00035 -0.01515" size="0.006" rgba="0.95 0.65 0.15 1"/>

            <!-- THE FEMTO MOUNT: the attach frame for the Orbbec Femto Bolt module
                 (dimensions.yaml head_assembly.galaxy_tablet.femto_mount). The mount's two legs
                 (y +/-41..60.55, x 40.75..70.75 mm) slide into two pockets in the face's holder,
                 held on all four sides, and leave it at the face's top face (z 52.0 from the tilt
                 axis). The frame is the centre of those pocket mouths, aligned with this body.
                 The module is its own body so it can be swapped as one: this is the FITTED mount,
                 the camera tilted 30 deg down; description/opendubs/variants.py swaps in the
                 straight one, moving the meshes, the collision boxes and both camera sites. -->
            <body name="femto_mount" pos="0.05575 0 0.052">
              <geom class="visual" type="mesh" mesh="femto_mount_tilt30" material="frame" pos="-0.05575 0.38 -0.9327"
                    name="femto_mount_visual"/>
              <!-- Coarse boxes from the mesh, about 2 mm outward, in this body's frame: the camera's
                   envelope as a box turned 30 deg down with it, and the mount as one box around
                   everything else (x 26.4..70.8, y +/-60.6, z 891.0..1019.3 mm in the export). -->
              <geom class="collision" type="box" pos="-0.00719 0 0.01445" size="0.02419 0.06255 0.06614"
                    name="femto_mount_collision"/>
              <geom class="collision" type="box" pos="0.01077 0 0.04164" size="0.0346 0.05958 0.0221"
                    quat="0.965926 0 0.258819 0" name="femto_bolt_collision"/>
              <!-- The cameras, on the two marks on the front face, at the surface: the true focal
                   points are behind the glass, by an amount not yet located. The front face is
                   turned 30 deg down with the mount. camera_link is the DEPTH camera,
                   OrbbecSDK_ROS2's root, x forward and pitched 6 deg DOWN from the colour camera
                   (Orbbec's documentation): +36 deg about y in all. camera_color is square to the
                   housing: +30 deg. -->
              <site name="camera_link"  pos="0.039004 -0.030 0.025341" quat="0.951057 0 0.309017 0"
                    size="0.004" rgba="0.15 0.65 0.95 1"/>
              <site name="camera_color" pos="0.038754 0.002 0.024908" quat="0.965926 0 0.258819 0"
                    size="0.004" rgba="0.95 0.35 0.15 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <tendon>
    <!-- The mixer, as geometry rather than as code. Each tendon's "length" is one of the three
         wheel-speed combinations driveMix() produces, so an actuator pulling on it commands
         exactly that motion and nothing else. Coefficients are 1/4 so a tendon's velocity
         reads as the average wheel speed in rad/s.
                            FL     FR     RL     RR      driveMix()
         fwd               +      +      +      +        fwd term
         strafe            +      -      -      +        str term
         rot               +      -      +      -        rot term                     -->
    <fixed name="drive_fwd">
      <joint joint="wheel_fl" coef="0.25"/>  <joint joint="wheel_fr" coef="0.25"/>
      <joint joint="wheel_rl" coef="0.25"/>  <joint joint="wheel_rr" coef="0.25"/>
    </fixed>
    <fixed name="drive_strafe">
      <joint joint="wheel_fl" coef="0.25"/>  <joint joint="wheel_fr" coef="-0.25"/>
      <joint joint="wheel_rl" coef="-0.25"/> <joint joint="wheel_rr" coef="0.25"/>
    </fixed>
    <fixed name="drive_rot">
      <joint joint="wheel_fl" coef="0.25"/>  <joint joint="wheel_fr" coef="-0.25"/>
      <joint joint="wheel_rl" coef="0.25"/>  <joint joint="wheel_rr" coef="-0.25"/>
    </fixed>
  </tendon>

  <actuator>
    <!-- Position control, matching how the real thing is commanded: a target height, with the
         firmware's guard and relays doing the work of getting there. -->
    <!-- Stiff, but also SLOW and FORCE-LIMITED. With stiffness alone the actuator drove the
         platform into its upper stop hard enough to throw the whole robot off the ground,
         which a screw-driven scissor cannot do: it is slow, and it can only push about as
         hard as its motor. forcerange caps the push; the joint's damping caps the speed at
         roughly (2500 - 245 N of load) / 40000 = 0.056 m/s, so the full 275 mm stroke takes
         about five seconds and arrives with no momentum worth speaking of.
         BOTH NUMBERS ARE PLACEHOLDERS — nobody has timed this lift or measured its thrust.
         They are chosen to be physically possible rather than to be right. -->
    <position name="zaxis_pos" joint="zaxis" kp="1000000" forcerange="-2500 2500"
              ctrlrange="0 0.2751"/>

    <!-- DRIVE, as the RC sticks give it: forward, strafe, rotate. Not one slider per wheel —
         a wheel at a time tells you nothing about a mecanum base, because the whole point is
         what the four do together.

         These drive the TENDONS defined above, whose coefficients ARE driveMix() from
         firmware/rc_serial_probe. So each slider is one stick: ctrl is in rad/s of wheel
         speed, and +/-10 is the 0.70 m/s that 10 rad/s gives at a 70 mm radius.
           drive_fwd     CH3    + forward
           drive_strafe  CH4    + right
           drive_rot     CH1    + turning right
         Three controls over four wheels is not a shortfall: a mecanum base has exactly three
         degrees of freedom, and the fourth wheel combination is internal slip that no stick
         commands and no driver wants. -->
    <velocity name="drive_fwd"    tendon="drive_fwd"    kv="4" ctrlrange="-10 10"/>
    <velocity name="drive_strafe" tendon="drive_strafe" kv="4" ctrlrange="-10 10"/>
    <velocity name="drive_rot"    tendon="drive_rot"    kv="4" ctrlrange="-10 10"/>

    <!-- The head. Without these the two head joints are the only unactuated ones in the whole
         model — the arms bring their own 18 with them — so the viewer's Control panel had
         sliders for everything except the thing we most want to aim.

         ctrlrange matches each joint's range exactly, so a slider cannot command past a limit
         the servo does not have. The tilt body's mass is MESH- AND BOX-DERIVED, at the density
         of water (5.1 kg; the real head is under 1 kg), with its centre of mass 47 mm from the
         axis, so gravity here pulls with up to 2.4 Nm and kp 60 holds it within about 2.3 deg.
         Weighing the head is a punch-list item; until then this sag is the model's, not the
         robot's. Pan carries no gravity load at all — its axis is vertical — so it only needs
         enough to feel crisp.

         Units are RADIANS, which is what the sliders show: tilt runs -1.636 (93.8 deg up) to
